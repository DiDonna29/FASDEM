		</action>
		<action path="/security/aps/buscarBeneficiario" type="ve.gob.dem.fasdem.action.comunes.BuscarBeneficiario" name="globalActionForm" validate="false" scope="request" parameter="/security/aps/buscarSiniestros.do">
