	<global-exceptions>
		<exception type="ve.gob.dem.framework.exception.PersonalNotSessionException" key="app.exception.nosession" handler="ve.gob.dem.framework.handler.CustomExceptionHandler" scope="request" />
		<exception type="ve.gob.dem.framework.exception.PersonalAccessDeniedException" key="app.exception.accessdenied" handler="ve.gob.dem.framework.handler.CustomExceptionHandler" scope="request" />
		<exception type="java.lang.Exception" key="app.exception.general" handler="ve.gob.dem.framework.handler.CustomExceptionHandler" scope="request" />
	</global-exceptions>
	<global-forwards>
		<forward name="index" path="/login.do" />
		<forward name="exception.page" redirect="false" path="/jsp/errores/exceptionPage.jsp" />
		<forward name="global.print" redirect="false" path="/jsp/reportes/redirect.jsp" />
		<forward name="intranet" path="http://intranet" redirect="true" />
		<forward name="input_maqueta" path="/jsp/maqueta/index.jsp" redirect="false" />
		<forward name="buscar.siniestro" path="/" redirect="false" />
	</global-forwards>
	<action-mappings>
		<action path="/login" type="ve.gob.dem.framework.seguridad.access.LoginUser" name="globalActionForm" validate="false" scope="request">
			<forward name="logged" redirect="false" path="/jsp/index.jsp" />
		</action>
		<action path="/noaccess" type="ve.gob.dem.framework.seguridad.access.ExceptionAction" />
		<action path="/nosession" type="ve.gob.dem.framework.seguridad.access.ExceptionAction" />
		<action path="/security/maqueta" parameter="1" type="ve.gob.dem.fasdem.action.maqueta.MaquetaAction">
			<forward name="input_maqueta" path="/jsp/maqueta/index.jsp" redirect="false" />
			<forward name="aps_carga" path="/maqueta/aps_carga.jsp" redirect="false" />
			<forward name="aps_consulta" path="/maqueta/aps_consulta.jsp" redirect="false" />
