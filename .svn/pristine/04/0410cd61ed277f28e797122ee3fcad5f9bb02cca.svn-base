package ve.gob.dem.fasdem.bean;

import java.io.Serializable;
import java.util.Date;

/**
 * @author marcenrl
 *
 */
public class Autorizacion implements Serializable{
   
	/**
	 * 
	 */
	private static final long serialVersionUID = 2130080585866133432L;
	private int id;
	private int id_siniestro;
	private int id_autoridad;
	private Date fecha_autorizacion;
	private Double monto_maximo_autorizado;
	private String observaciones;
	private Autoridades autoridad;  
	
	public int getId() {
		return id;
	}
	public void setId(int id) {
		this.id = id;
	}
	public int getId_siniestro() {
		return id_siniestro;
	}
	public void setId_siniestro(int idSiniestro) {
		id_siniestro = idSiniestro;
	}

	public Date getFecha_autorizacion() {
		return fecha_autorizacion;
	}
	public void setFecha_autorizacion(Date fechaAutorizacion) {
		fecha_autorizacion = fechaAutorizacion;
	}
	public Double getMonto_maximo_autorizado() {
		return monto_maximo_autorizado;
	}
	public void setMonto_maximo_autorizado(Double montoMaximoAutorizado) {
		monto_maximo_autorizado = montoMaximoAutorizado;
	}
	public String getObservaciones() {
		return observaciones;
	}
	public void setObservaciones(String observaciones) {
		this.observaciones = observaciones;
	}
	public static long getSerialversionuid() {
		return serialVersionUID;
	}
	public int getId_autoridad() {
		return id_autoridad;
	}
	public void setId_autoridad(int idAutoridad) {
		id_autoridad = idAutoridad;
	}
	public Autoridades getAutoridad() {
		return autoridad;
	}
	public void setAutoridad(Autoridades autoridad) {
		this.autoridad = autoridad;
	}


}
