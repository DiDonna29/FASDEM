<%@ taglib uri="/WEB-INF/tlds/struts-bean.tld" prefix="bean" %>
<%@taglib uri="/WEB-INF/tlds/struts-tiles.tld" prefix="tiles" %>
<%@taglib uri="/WEB-INF/tlds/struts-logic-el.tld" prefix="logic" %>
<%@taglib uri="/WEB-INF/tlds/struts-html.tld" prefix="html" %>
<%@ taglib uri="/WEB-INF/tlds/fmt.tld" prefix="fmt" %>
<%@ taglib uri="/WEB-INF/tlds/c.tld" prefix="c" %>
<%@ page import="java.util.Date"%>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1">
<link href="<%=request.getContextPath()%>/style/css.css" rel="stylesheet" type="text/css">
<title><bean:message key="app.titulo" bundle="etiquetas"/></title>
<script language="JavaScript">
<!--Script courtesy of http://www.web-source.net - Your Guide to Professional Web Site Design and Development
var time = null
function move() {
window.location = '<%=request.getContextPath()%>/'
}
//-->
</script>
</head>
<body  onload="timer=setTimeout('move()',6000)" style="background-color:#FFFFFF">





<table width="100%"  border="0" cellpadding="5" cellspacing="5" align="center">



	<tr>
		<td   align="center" class="nblack" style="font-size:x-large;font-family:Arial, Helvetica, sans-serif" >
			<h1>No encontrado</h1>
Oficina de Desarrollo Infomático - ODI
		</td>
	</tr>
	<tr>
		<td  align="center" class="cg" style="font-size:large">
			La URL solicitada no fué encontrada en este servidor.
		</td>
	</tr>
	<tr>
		<td  align="center" class="nred" >
			<a href="<%=request.getContextPath()%>/">Ir al inicio</a>
		</td>
	</tr>	
</table>
</body>
</html>
