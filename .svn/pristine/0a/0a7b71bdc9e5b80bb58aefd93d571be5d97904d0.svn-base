package ve.gob.dem.fasdem.bean;

import java.io.Serializable;

/**
 * @author marcenrl
 * 
 */
public class EstatusTipoTramite implements Serializable {

    /**
	 * 
	 */
	private static final long serialVersionUID = -6741946173479627283L;
	private int id;
	private int idEstatus;
	private int idTipoTramite;
	private String reporte;
	
	public int getId() {
	return id;
    }

    public void setId(int id) {
	this.id = id;
    }

   
	public int getIdEstatus() {
		return idEstatus;
	}

	public void setIdEstatus(int idEstatus) {
		this.idEstatus = idEstatus;
	}

	public int getIdTipoTramite() {
		return idTipoTramite;
	}

	public void setIdTipoTramite(int idTipoTramite) {
		this.idTipoTramite = idTipoTramite;
	}

	public String getReporte() {
		return reporte;
	}

	public void setReporte(String reporte) {
		this.reporte = reporte;
	}
}
