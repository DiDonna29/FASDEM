<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap
 PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
 "http://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap namespace="Foto">
	<typeAlias alias="ObjFoto" type="ve.gob.dem.fasdem.bean.Foto"/>
	<resultMap id="result_all" class="ObjFoto">
		<result property="id" column="id" jdbcType="integer"/>
		<result property="cedula" column="cedula" jdbcType="integer"/>
		<result property="data" column="archivo" jdbcType="bytea"/>
	</resultMap>
	<select id="search" resultClass="ObjFoto" resultMap="result_all">
		SELECT 
			a.id,
			p.cedula,
			archivo
		FROM 
			archivo as a, 
			persona as p
		WHERE 
			a.id = p.foto_id AND
			p.cedula = #value#
	limit 1
		
	</select>
</sqlMap>
