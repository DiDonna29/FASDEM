			Date fechaMenoss = today;
			Calendar ff = Calendar.getInstance();
			SimpleDateFormat formato = new SimpleDateFormat("dd/MM/yyyy");
			ff.setTime(fechaMenoss);
			ff.add(Calendar.MONTH, -1);
			formato.format(ff.getTime());
			String fecha_menos = formato.format(ff.getTime());
			Date fecha_menoss = Utilidad
					.StringToDate(fecha_menos, "dd/MM/yyyy");
			Date fechaIngreso = mapa.getFechaIngreso();
			Calendar fff = Calendar.getInstance();

			fff.setTime(fechaIngreso);
			formato.format(fff.getTime());
			String fecha_ingreso = formato.format(fff.getTime());
			Date fecha_ingresoo = Utilidad.StringToDate(fecha_ingreso,
					"dd/MM/yyyy");
			if (fecha_ingresoo.compareTo(fecha_menoss) < 0) {
				am.add(ALERT_AVISOS, new ActionMessage(
