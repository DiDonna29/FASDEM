				am.add(ALERT_AVISOS, new ActionMessage(
						"env.general.padreerroneo"));
				saveMessages(request, am);
				return mapping.findForward("regreso");
			} else {
				if (siniPadre.getEstatus().getId() == 34) {
					am.add(ALERT_AVISOS, new ActionMessage(
