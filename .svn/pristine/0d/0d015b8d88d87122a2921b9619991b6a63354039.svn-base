			mapa.setMontoNoAmparado(montoNoAmparado);
			mapa.setIdTipoEnfermedad(COD_TIPO_ENFERMEDAD_AGUDA);
			if (request.getParameter("fechaEgreso") == null
					|| request.getParameter("fechaEgreso") == "") {
			} else {
