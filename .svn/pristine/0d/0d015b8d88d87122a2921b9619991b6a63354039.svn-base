public class CargarEmergencia extends GenericAction {
	@Override
	public ActionForward execute(ActionMapping mapping, ActionForm form,
			HttpServletRequest request, HttpServletResponse response)
			throws Exception {
		ActionMessages am = new ActionMessages();
		Entorno ent = new Entorno(Entorno.MOD_EMERGENCIA_NUEVO);
		request.setAttribute(KEY_TIPO_TRAMITE, TIPO_TRAMITE_EMERGENCIA);
	
		request.setAttribute("tlf", request.getParameter("tlf"));
		request.setAttribute("bb", request.getParameter("bb"));
		request.setAttribute("tt", request.getParameter("tt"));
		request.setAttribute("bb", request.getAttribute("bb"));
		request.setAttribute("tt", request.getAttribute("tt"));
		PerPoliza pp = new PerPoliza();
		PerSiniestro ps = new PerSiniestro();
		PerNotaTecnica pnt = new PerNotaTecnica();	
		Siniestro siniPadre = null;
		Mapa mapa = new Mapa();
		int idSini = -1;

		Siniestro s = null;
		Date today = new Date();
		log.info("aqui paso el lider66666 "+request.getAttribute("bb")+",,,,, "+request.getAttribute("tt"));
		String bb="";
		bb=(String) request.getAttribute("bb");
		String ttt="";
		ttt=(String) request.getAttribute("tt");
		request.setAttribute("requestCedTitular", ttt);
		request.setAttribute("requestCedBeneficiario", bb);
		request.setAttribute("valida_emergencia", 1);
		Persona t = buscarTitularBeneficiario(request);
		request.setAttribute("sms", request.getParameter("sms"));
		//request.setAttribute("tlf", request.getParameter("tlf"));
		if ("INACTIVO".equals(t.getBeneficiario().getEstatus())) {
			am.add(ALERT_AVISOS, new ActionMessage("env.general.inactivo"));
			saveMessages(request, am);
			return mapping.findForward(FWD_INDEX);
		}

		String paramSiniPadre = request.getParameter("idSiniPadre");
		
		DynaActionForm dForm = (DynaActionForm) form;
		SiniestroBandeja siniestroBandeja = new SiniestroBandeja();
		mapa.setAnioSiniestro(getAnioBusqueda(request));
		if (request.getParameter("paramNewSini") != null) {
			request.getSession().removeAttribute("siniestroPadre");
			paramSiniPadre = null;
		}

		if (paramSiniPadre != null) {
			
			mapa.setIdSiniestro(Integer.parseInt(paramSiniPadre));
			siniPadre = ps.search(mapa);
		
			
			
			

			// if (siniPadre.getCobertura().getId()==8){ent = new
			// Entorno(Entorno.MOD_EMERGENCIA_NUEVO_SECUELA);}
			// else {ent = new Entorno(Entorno.MOD_EMERGENCIA_NUEVO); }
			if (siniPadre.getTipoTramite().getId() != 1
