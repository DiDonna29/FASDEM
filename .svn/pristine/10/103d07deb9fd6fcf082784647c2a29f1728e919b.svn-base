<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="DetalleClinicasEstadosRazonable"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="552"
		 pageHeight="612"
		 columnWidth="552"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="ruta" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["C://Tomcat//webapps//fd//"]]></defaultValueExpression>
	</parameter>
	<parameter name="servicio" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Clinicas"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_estado" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(25)]]></defaultValueExpression>
	</parameter>
	<parameter name="id_ciudad" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(891)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
proveedor.Descripcion,
proveedor.direccion,
proveedor.telefono,
proveedor.servicios,
servicio_portal.descripcion_tipo as servicio,
servicio_portal.id_serpor as id_servicio,
estado.descripcion as estado, ciudad.descripcion as ciudad
from proveedor
inner join servicio_portal_proveedor on (proveedor.is_costo_razonable = true and proveedor.id_proveedor = servicio_portal_proveedor.id_proveedor and  servicio_portal_proveedor.is_activo = true and proveedor.is_activo = true )
inner join servicio_portal on (servicio_portal.id_serpor = servicio_portal_proveedor.id_serpor and servicio_portal.descripcion_tipo = $P{servicio})
inner join estado on (proveedor.id_estado = estado.id_estado and proveedor.id_estado = $P{id_estado})
inner join ciudad on (proveedor.id_ciudad = ciudad.id_ciudad and ciudad.id_estado = estado.id_estado and ciudad.id_ciudad = $P{id_ciudad} )
order by servicio_portal.id_serpor, ciudad.descripcion,proveedor.Descripcion]]></queryString>

	<field name="descripcion" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="servicios" class="java.lang.String"/>
	<field name="servicio" class="java.lang.String"/>
	<field name="id_servicio" class="java.lang.Integer"/>
	<field name="estado" class="java.lang.String"/>
	<field name="ciudad" class="java.lang.String"/>

	<variable name="varjc" class="java.lang.String" resetType="Column" calculation="System">
