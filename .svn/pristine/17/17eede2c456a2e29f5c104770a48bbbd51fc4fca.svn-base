					<bottomPen lineWidth="0.0" lineStyle="Solid"/>
					<rightPen lineWidth="0.0" lineStyle="Solid"/>
</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA["LISTADO DE CLÍNICAS AFILIADAS \n CON COSTOS RAZONABLES  \n CARACAS ACTUALIZADO AL"+$F{fecha_impresion}]]></textFieldExpression>
				</textField>
			</band>
