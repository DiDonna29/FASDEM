package ve.gob.dem.fasdem.bean;

import java.io.Serializable;

/**
 * @author marcenrl
 * 
 */
public class CuentaBenef implements Serializable {
	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	/**
	 * 
	 */
	
	private int cedula;
	private String numero_cuenta;
	private String tipo_cuenta;
	private String idBanco;
	private String nombreBanco;
	private int id_cuenta_beneficiario;
	private boolean is_activo;

	

	public String getNumero_cuenta() {
		return numero_cuenta;
	}

	public void setNumero_cuenta(String numero_cuenta) {
		this.numero_cuenta = numero_cuenta;
	}

	public String getTipo_cuenta() {
		return tipo_cuenta;
	}

	public void setTipo_cuenta(String tipo_cuenta) {
		this.tipo_cuenta = tipo_cuenta;
	}

	public String getIdBanco() {
		return idBanco;
	}

	public void setIdBanco(String idBanco) {
		this.idBanco = idBanco;
	}

	public boolean isIs_activo() {
		return is_activo;
	}

	public void setIs_activo(boolean is_activo) {
		this.is_activo = is_activo;
	}

	public int getCedula() {
		return cedula;
	}

	public void setCedula(int cedula) {
		this.cedula = cedula;
	}

	public int getId_cuenta_beneficiario() {
		return id_cuenta_beneficiario;
	}

	public void setId_cuenta_beneficiario(int id_cuenta_beneficiario) {
		this.id_cuenta_beneficiario = id_cuenta_beneficiario;
	}
	/**
	 * @return the nombreBanco
	 */
	public String getNombreBanco() {
		return nombreBanco;
	}

	/**
	 * @param nombreBanco
	 *            the nombreBanco to set
	 */
	public void setNombreBanco(String nombreBanco) {
		this.nombreBanco = nombreBanco;
	}

	/**
	 * @return the serialversionuid
	 */
	public static long getSerialversionuid() {
		return serialVersionUID;
	}
}
