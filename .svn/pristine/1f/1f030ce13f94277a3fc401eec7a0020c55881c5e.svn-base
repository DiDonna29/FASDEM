package ve.gob.dem.framework.seguridad.bean;

import java.io.Serializable;

/**
 * @author hvazquez
 * 
 *         To change the template for this generated type comment go to
 *         Window&gt;Preferences&gt;Java&gt;Code Generation&gt;Code and Comments
 */
public class Proyecto implements Serializable {

    /**
     * 
     */
    private static final long serialVersionUID = -5072263577070561368L;
    private int id = 0;
    private String paginahome = "";
    private String paginalogin = "";

    /**
     * @return
     */
    public int getId() {
	return id;
    }

    /**
     * @return
     */
    public String getPaginahome() {
	return paginahome;
    }

    /**
     * @return
     */
    public String getPaginalogin() {
	return paginalogin;
    }

    /**
     * @param string
     */
    public void setId(int string) {
	id = string;
    }

    /**
     * @param string
     */
    public void setPaginahome(String string) {
	paginahome = string;
    }

    /**
     * @param string
     */
    public void setPaginalogin(String string) {
	paginalogin = string;
    }
}
