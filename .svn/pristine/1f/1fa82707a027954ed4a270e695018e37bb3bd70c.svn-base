<?xml version="1.0" encoding="UTF-8"  ?>
<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="Siniestrosliq"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="3749"
		 pageHeight="595"
		 columnWidth="3749"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false"
		 isIgnorePagination="true">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="ruta" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Z:\\webapps\\fasdem\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="anio" isForPrompting="false" class="java.lang.Integer"/>
	<parameter name="mes" isForPrompting="true" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT
	aniomes_codigo||'-'||codigo_siniestro||'-'||subcodigo_siniestro as codigo_completo,
	s.cedula as cedula_titular,
	observacion as Observacion,
	s.nombres ||' '|| s.apellidos as nombres_titular,
	s.nombres_beneficiario ||' '|| s.apellidos_beneficiario as nombres_beneficiario,
	te.descripcion as condicion_trabajador,
	f.nro_factura as numero_factura,
	f.fecha_factura as fecha_factura,
	s.monto_presupuestado as monto_presupuestado,
	s.monto_negociado as monto_negociado,
	s.monto_no_amparado as monto_no_amparado,
	f.monto_total as total,
	es.descripcion as etapa_siniestro,
	tt.descripcion as tipo_tramite,
	tipo_proveedor.descripcion as tipo_proveedor,
	p.descripcion as proveedor,
	stdo.descripcion as estado_clinica,
	e.descripcion as especialidad,
	s.fecha_registro,
	s.id_usuario,
	f.nro_control,
	f.pre_orden,
	s.monto_amparado,
	d.descripcion as dependencia,
	st.descripcion as estado,
	tratamiento.descripcion as tratamiento,
	tipo_siniestro.descripcion as tipo_siniestro,
	patologias.descripcion as patologia,
	tipo_cobertura.descripcion as cobertura,
	cita_post_operatorio as Cita_Post_Operatoria
FROM
	public.siniestro s
	LEFT JOIN public.facturas f 
		ON s.id_siniestro = f.id_siniestro
	INNER JOIN proveedor 
		ON s.id_proveedor = proveedor.id_proveedor 
	INNER JOIN tipo_proveedor 
		ON proveedor.id_tipo_proveedor= tipo_proveedor.id_tipo_proveedor
	INNER JOIN patologia_organo_tratamiento 
		ON (s.id_patologia_organo_tratamiento= patologia_organo_tratamiento.id_pat_org_trat_esp)
	INNER JOIN especialidad 
		ON (patologia_organo_tratamiento.id_especialidad = especialidad.id_especialidad)
	INNER JOIN organo 
		ON (patologia_organo_tratamiento.id_organo = organo.id_organo)
	INNER JOIN patologias 
		ON (patologia_organo_tratamiento.id_patologia = patologias.id_patologia)
	INNER JOIN tratamiento 
		ON (patologia_organo_tratamiento.id_tratamiento = tratamiento.id_tratamiento)
	INNER JOIN tipo_siniestro 
		ON (s.id_tipo_siniestro = tipo_siniestro.id_tipo_siniestro)
	INNER JOIN tipo_cobertura 
		ON (s.id_cobertura =tipo_cobertura.id_tipo_cobertura),
	public.tipo_empleado te,
	public.tipo_tramite tt,
	public.estatus_siniestro es,
	public.proveedor p
	LEFT JOIN public.estado stdo 
		ON p.id_estado = stdo.id_estado, 
	public.patologia_organo_tratamiento pot,
	public.especialidad e,
	public.dependencia d,
	public.estado st
WHERE
	  s.anio_siniestro = $P{anio} AND 
	  f.anio_siniestro = $P{anio} AND
	s.id_tipo_empleado = te.id_tipo_empleado AND
	s.id_patologia_organo_tratamiento = pot.id_pat_org_trat_esp AND
	tt.id_tipo_tramite = s.id_tipo_tramite AND
	es.id_estatus_siniestro = s.id_estatus AND
	p.id_proveedor = s.id_proveedor AND
	s.id_dependencia = d.id AND 
	st.id_estado = d.id_estado AND
	e.id_especialidad = pot.id_especialidad AND 
	s.id_estatus= '4' AND 
	substr(s.aniomes_codigo, 3)::int = $P{mes}]]></queryString>

