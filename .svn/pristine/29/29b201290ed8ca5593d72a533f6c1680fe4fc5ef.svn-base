<%@ taglib uri="/WEB-INF/tlds/struts-bean.tld" prefix="bean" %>
<%@taglib uri="/WEB-INF/tlds/struts-tiles.tld" prefix="tiles" %>
<%@taglib uri="/WEB-INF/tlds/struts-logic-el.tld" prefix="logic" %>
<%@taglib uri="/WEB-INF/tlds/struts-html.tld" prefix="html" %>
<%@ taglib uri="/WEB-INF/tlds/fmt.tld" prefix="fmt" %>
<%@ taglib uri="/WEB-INF/tlds/c.tld" prefix="c" %>
<%@ page import="java.util.Date"%>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1">
<link href="<%=request.getContextPath()%>/style/css.css" rel="stylesheet" type="text/css">
<title><bean:message key="app.titulo" bundle="etiquetas"/></title>
</head>
<body>
<form name="form_main">

<table width="100%" bgcolor="#003365" border="0" cellpadding="0" cellspacing="0">
	<tr>
		<td align="left" background="<%=request.getContextPath()%>/images/f_cabc.gif">
            <table width="770" border="0" cellpadding="0" cellspacing="0" align="center">
                <tr>
                    <td width="258" align="left" valign="top">
                    <table width="100%" cellpadding="0" cellspacing="0">
    
                        <tr height="26" >
                            <td valign="bottom">
                            <img
                                src="<%=request.getContextPath()%>/images/cbc_intranet.gif"
                                width="252" height="21">
                            </td>
                        </tr>
                        <tr><td class="ntextblue" valign="bottom"><div class="sp5"></div>Dirección Ejecutiva de la Magistratura</td></tr>
                    </table>
                    </td>
                    <td width="181" align="middle" class="white"  valign="middle">&nbsp;</td>
                    <td width="331" align="right" valign="bottom">
                        <table width="100%" border="0" cellpadding="0" cellspacing="0" height="44">
                            <tr>
                                <td width="21"><img src="<%=request.getContextPath()%>/images/rec_yelow1.gif" valign="middle" width="21" height="44"></td>
                                <td background="<%=request.getContextPath()%>/images/f_s_cabc.gif" valign="bottom">
                                    <table width="100%" cellpadding="0" cellspacing="0" height="29">
                                        <tr><td class="textblue" >Bienvenido (a): <span class="nblue"><c:out value="${usuario.nombre} ${usuario.apellido}"/> </span></td></tr>
                                        <tr><td class="cgp"><jsp:useBean id="ahora" class="java.util.Date" /><fmt:formatDate pattern="EEEEEEEEEEE  d 'de' MMMMMMM 'de' yyyy" value="${ahora}"/></td></tr>
                                    </table>
                                </td>
                                <td width="21"><img src="<%=request.getContextPath()%>/images/rec_yelow2.gif" width="21" height="44"></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
		</td>
	</tr>
	<tr bgcolor="#436d9f">
		<td bgcolor="#436d9f"><img src="<%=request.getContextPath()%>/images/pix.htm" width="1" height="1"></td>
	</tr>
</table>



<table width="100%" bgcolor="#ffffff" cellpadding="0" cellspacing="0">
	<tr>
		<td bordercolor="EEF4FF">
            <table width="750" align="center" cellpadding="0" cellspacing="0">
                <tr>
                    <td width="177"><img src="<%=request.getContextPath()%>/images/l_zexcls.gif" width="177" height="53"></td>
                    <td><img src="<%=request.getContextPath()%>/images/cbc_escabinos1.jpg" width="574" height="53"></td>
                </tr>
            </table>
		</td>
	</tr>
	<tr>
		<td background="<%=request.getContextPath()%>/images/f_franja.gif" valign="top">
		<table width="750" align="center" cellpadding="0" cellspacing="0">
			<tr>
				<td width="177"><img
					src="<%=request.getContextPath()%>/images/pix.htm" width="1"
					height="11"></td>
				<td align="left"><img 
					src="<%=request.getContextPath()%>/images/cbc_escabinos2.jpg"
					width="574" height="11"></td>
			</tr>
		</table>
		</td>
	</tr>
	<tr>
		<td bgcolor="#eef4ff">
		<table width="770" align="center" border="0" cellpadding="0"
			cellspacing="0">
			<tr>
				<td width="321" align="right"><img
					src="<%=request.getContextPath()%>/images/orlas_internas0.gif"
					width="133" height="26"></td>
				<td width="449" align="left">
                    <table width="70%" border="0" cellpadding="0" cellspacing="0">
                        <tr>
                            <td width="30" valign="top">
                            <img
                                src="<%=request.getContextPath()%>/images/curva_intern.gif"
                                width="30" height="26">
                            </td>
                            <td class="textorange Estilo1" width="505" align="right"
                                background="<%=request.getContextPath()%>/images/curva_f.gif"
                                valign="middle"><div><bean:message key="app.titulo" bundle="etiquetas"/></div></td>
                            <td width="30" valign="top"><img
                                src="<%=request.getContextPath()%>/images/curvas_intern2.gif"
                                width="30" height="26"></td>
                        </tr>
                    </table>
				</td>
			</tr>
			<tr>
				<td align="right"><img
					src="<%=request.getContextPath()%>/images/orlas_internas1.gif"
					width="133" height="23"></td>
				<td align="left"><img
					src="<%=request.getContextPath()%>/images/orlas_internas2.gif"
					width="253" height="23"></td>
			</tr>
		</table>
		</td>
	</tr>
</table>

<table width="770" align="center" border="0" cellpadding="0"
	cellspacing="0">

	<tr>
		<td colspan="3"
			background="<%=request.getContextPath()%>/images/busc_linesh.gif"><img
			src="<%=request.getContextPath()%>/images/pix.htm" width="1"
			height="1"></td>
	</tr>

	<tr>
		<td width="1"
			background="<%=request.getContextPath()%>/images/busc_linesv.gif"><img
			src="<%=request.getContextPath()%>/images/busc_linesv.gif" width="1"
			height="1"></td>
		<td align="center" valign="middle">
		<table width="100%" border="0" cellpadding="0" cellspacing="10"
			height="100%">


            


						
            
            
            
            
            
            
            
            
            
            
            
            
            
            
			<tr>
				<td align="center" bgcolor="#ffffff" valign="top">



				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<!--DWLayoutTable-->
					<tr>

						<td   valign="top">
						<div class="s10"></div>
        <table width="97%" align="center" cellpadding="0" cellspacing="0">
            <tr>
                <td class="blackg" align="left" bgcolor="#ebf0f8" height="15">
                        <strong style="padding-left:5px;">Mensajes del Sistema</strong>
                </td>
            </tr>
            <tr class="black" bgcolor="#dbdbdb" height="100%">
                <td valign="top" class="blackg" align="center" style="padding:5px;">



Recurso solicitado no se encuentra disponible
</td>
            </tr>
            
            <tr class="black" bgcolor="#dbdbdb" height="100%">
                <td valign="top" class="blackg" align="center" style="padding:5px;">



<a href="<%=request.getContextPath()%>/">Ir al inicio</a>
</td>
            </tr>            
        </table>    
                        </td>
                        
					</tr>


				</table>
            <div class="s10"></div>
				</td>
			</tr>

		</table>
		</td>

		<td width="1"
			background="<%=request.getContextPath()%>/images/busc_linesv.gif"><img
			src="<%=request.getContextPath()%>/images/pix.htm" width="1"
			height="1"></td>
	</tr>
	<tr>
		<td colspan="3"
			background="<%=request.getContextPath()%>/images/busc_linesh.gif"><img
			src="<%=request.getContextPath()%>/images/bg1.htm" width="1"
			height="1"></td>
	</tr>

</table>




<div class="s10"></div>

<table width="770" align="center" border="0" cellpadding="0"
	cellspacing="0">
	<tr>
		<td align="left" bgcolor="#8d8d8d" valign="top"><img width="5"
			height="1"></td>
	</tr>
	<tr>
		<td align="middle" height="38" valign="center">
		<div class="titblue" align="center">
        Poder Judicial.Sitio web creado y diseñado por la <a href="mailto:webmaster.portal@dem.gob.ve" target="_blank">Oficina de Desarrollo Informático</a> de la Dirección Ejecutiva <br> de la Magistratura del Tribunal Supremo de Justicia. Todos los Derechos Reservados. <br>
		</div>
		</td>
	</tr>
</table>
</form>
</body>
</html>
