	<field name="mtoisr" class="java.lang.Double"/>
	<field name="porriv" class="java.lang.Double"/>
	<field name="mtotmf" class="java.lang.Double"/>

	<variable name="SINIESTRO" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[$F{nrosin}+ " " + $F{nropag}]]></variableExpression>
	</variable>
	<variable name="TOTAL_PAGAR" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{MTO_PAG_DET}]]></variableExpression>
	</variable>
	<variable name="TOTAL_RETENCIONIVA" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{porriv}]]></variableExpression>
	</variable>
	<variable name="TOTAL_TIMBRE" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtotmf}]]></variableExpression>
	</variable>
	<variable name="TOTAL_MTOISLR" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double(  ($F{mtoisr}.doubleValue()) *($P{APLICA_ISRL}.intValue()) )]]></variableExpression>
	</variable>
	<variable name="TOTAL_GASTOS_CLI" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtocli}]]></variableExpression>
	</variable>
	<variable name="TOTAL_MTO_LIQ" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtoliq}]]></variableExpression>
	</variable>
	<variable name="TOTAL_MTO_FAC" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtofac}]]></variableExpression>
	</variable>
	<variable name="ETIQUETA" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[($P{fechacheque}==null)?"FINIQUITO DE PAGO":""]]></variableExpression>
	</variable>
	<variable name="MTO_PAG_DET" class="java.lang.Double" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{mtoliq}.doubleValue()) - (($F{mtoisr}.doubleValue())*($P{APLICA_ISRL}.doubleValue())) -($F{mtotmf}.doubleValue())- ($V{RET_IVA}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="TOTAL_HONORARIOS" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtohono}]]></variableExpression>
	</variable>
	<variable name="TOTA_IVA" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{porriv}]]></variableExpression>
	</variable>
	<variable name="RET_IVA" class="java.lang.Double" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{porriv}.doubleValue()) *($P{POR_RETENCION}.doubleValue())/100 )]]></variableExpression>
	</variable>
	<variable name="TOTAL_RET_IVA" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{RET_IVA}]]></variableExpression>
	</variable>
