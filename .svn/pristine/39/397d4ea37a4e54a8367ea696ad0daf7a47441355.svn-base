package ve.gob.dem.fasdem.bean;

import java.io.Serializable;

/**
 * @author marcenrl
 * 
 */
public class TipoEnfermedad implements Serializable {

    /**
	 * 
	 */
	private static final long serialVersionUID = 7955335629458336481L;
	private int id;
    private int idMedicinas;
    private String descripcionMedicinas;
    private String textoInicio;
    private String textoFin;
    private String descripcion;
    private double monto;
    private int dias;
    private int contador;
    private String mesmedicina;
 

	public int getDias() {
		return dias;
	}

	public void setDias(int dias) {
		this.dias = dias;
	}

	public int getContador() {
		return contador;
	}

	public void setContador(int contador) {
		this.contador = contador;
	}

	public double getMonto() {
		return monto;
	}

	public void setMonto(double monto) {
		this.monto = monto;
	}

	public int getIdMedicinas() {
		return idMedicinas;
	}

	public void setIdMedicinas(int idMedicinas) {
		this.idMedicinas = idMedicinas;
	}

	public String getDescripcionMedicinas() {
		return descripcionMedicinas;
	}

	public void setDescripcionMedicinas(String descripcionMedicinas) {
		this.descripcionMedicinas = descripcionMedicinas;
	}

	public String getTextoInicio() {
		return textoInicio;
	}

	public void setTextoInicio(String textoInicio) {
		this.textoInicio = textoInicio;
	}

	public String getTextoFin() {
		return textoFin;
	}

	public void setTextoFin(String textoFin) {
		this.textoFin = textoFin;
	}

	public int getId() {
	return id;
    }

    public void setId(int id) {
	this.id = id;
    }

    public String getDescripcion() {
	return descripcion;
    }

    public void setDescripcion(String descripcion) {
	this.descripcion = descripcion;
    }

	public String getMesmedicina() {
		return mesmedicina;
	}

	public void setMesmedicina(String mesmedicina) {
		this.mesmedicina = mesmedicina;
	}
    
}
