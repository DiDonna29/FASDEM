				<textFieldExpression   class="java.lang.String"><![CDATA["En virtud de lo antes expuesto LA DIRECCIÓN EJECUTIVA DE LA MAGISTRATURA, se hace responsable hasta por el monto máximo de BOLÍVARES "+new ve.gob.dem.reportes.utilidades.NumerosLetras().convertirLetras($V{total_amparado}.toString())+ "(" +new ve.gob.dem.reportes.utilidades.FormatoNumeros().formatoNumero($V{total_amparado}.toString())+ ") como monto único total y definitivo a ser depositado en la cuenta "  +$P{cuenta}+ " por " +$F{tipo_siniestro}+ " realizado a " +$F{beneficiario}+ " por presentar " +$F{tratamiento}+ " en fecha " +$F{fecha_ocurrencia2}+"\n"]]></textFieldExpression>
