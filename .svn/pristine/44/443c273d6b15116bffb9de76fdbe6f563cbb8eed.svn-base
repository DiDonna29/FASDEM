	<field name="monto_timbre" class="java.lang.Double"/>
	<field name="numero_pagos" class="java.lang.Long"/>

	<variable name="total_amparado" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{gastos_clinicos}.doubleValue()) +($F{honorarios_medicos}.doubleValue())+($F{material_iva}.doubleValue())+($F{material}.doubleValue())+($F{odontologia}.doubleValue())+($F{funerarios}.doubleValue())+($F{vida}.doubleValue())+($F{ambulancia}.doubleValue())+($F{medicinas}.doubleValue())+($F{otros}.doubleValue()))
]]></variableExpression>
	</variable>
	<variable name="total_pres" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{gastos_clinicos_pres}.doubleValue()) +($F{honorarios_medicos_pres}.doubleValue())+($F{material_iva_pres}.doubleValue())+($F{material_pres}.doubleValue())+($F{odontologia_pres}.doubleValue())+($F{funerarios_pres}.doubleValue())+($F{vida_pres}.doubleValue())+($F{ambulancia_pres}.doubleValue())+($F{medicinas_pres}.doubleValue())+($F{otros_pres}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="total_neg" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{gastos_clinicos_neg}.doubleValue()) +($F{honorarios_medicos_neg}.doubleValue())+($F{material_iva_neg}.doubleValue())+($F{material_neg}.doubleValue())+($F{odontologia_neg}.doubleValue())+($F{funerarios_neg}.doubleValue())+($F{vida_neg}.doubleValue())+($F{ambulancia_neg}.doubleValue())+($F{medicinas_neg}.doubleValue())+($F{otros_neg}.doubleValue()))]]></variableExpression>
	</variable>
