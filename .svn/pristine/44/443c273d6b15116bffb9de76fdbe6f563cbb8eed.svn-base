<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="detalleFac"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="4096"
		 pageHeight="792"
		 columnWidth="4096"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="2" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="idfactura" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["197"]]></defaultValueExpression>
	</parameter>
	<parameter name="anioSiniestro" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["2011"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select  
sum(COALESCE(gastos_clinicos, 0::double precision)) AS gastos_clinicos,
sum(COALESCE(gastos_clinicos_pres, 0::double precision)) AS gastos_clinicos_pres,
sum(COALESCE(gastos_clinicos_neg, 0::double precision)) AS gastos_clinicos_neg,
sum(COALESCE(honorarios_medicos, 0::double precision)) AS honorarios_medicos,
sum(COALESCE(honorarios_medicos_pres, 0::double precision)) AS honorarios_medicos_pres,
sum(COALESCE(honorarios_medicos_neg, 0::double precision)) AS honorarios_medicos_neg,
sum(COALESCE(material_iva, 0::double precision))AS material_iva,
sum(COALESCE(material_iva_pres, 0::double precision))AS material_iva_pres,
sum(COALESCE(material_iva_neg, 0::double precision))AS material_iva_neg,
sum(COALESCE(material, 0::double precision)) AS material,
sum(COALESCE(material_pres, 0::double precision)) AS material_pres,
sum(COALESCE(material_neg, 0::double precision)) AS material_neg,
sum(COALESCE(odontologia, 0::double precision)) AS odontologia,
sum(COALESCE(odontologia_pres, 0::double precision)) AS odontologia_pres,
sum(COALESCE(odontologia_neg, 0::double precision)) AS odontologia_neg,
sum(COALESCE(funerarios, 0::double precision)) AS funerarios,
sum(COALESCE(funerarios_pres, 0::double precision)) AS funerarios_pres,
sum(COALESCE(funerarios_neg, 0::double precision)) AS funerarios_neg,
sum(COALESCE(vida, 0::double precision)) AS vida,
sum(COALESCE(vida_pres, 0::double precision)) AS vida_pres,
sum(COALESCE(vida_neg, 0::double precision)) AS vida_neg,
sum(COALESCE(ambulancia, 0::double precision)) AS ambulancia,
sum(COALESCE(ambulancia_pres, 0::double precision)) AS ambulancia_pres,
sum(COALESCE(ambulancia_neg, 0::double precision)) AS ambulancia_neg,
sum(COALESCE(farmacia, 0::double precision)) AS medicinas,
sum(COALESCE(farmacia_pres, 0::double precision)) AS medicinas_pres,
sum(COALESCE(farmacia_neg, 0::double precision)) AS medicinas_neg,
sum(COALESCE(otros, 0::double precision)) AS otros,
sum(COALESCE(otros_pres, 0::double precision)) AS otros_pres,
sum(COALESCE(otros_neg, 0::double precision)) AS otros_neg,
sum((COALESCE(gastos_clinicos, 0::double precision) + COALESCE(odontologia, 0::double precision)  + COALESCE(funerarios, 0::double precision) + COALESCE(ambulancia, 0::double precision) + COALESCE(otros, 0::double precision)) ) as base_imponible_isrl,
sum((COALESCE(material_iva, 0::double precision) + COALESCE(ambulancia, 0::double precision)  + COALESCE(funerarios, 0::double precision) + COALESCE(otros, 0::double precision)) ) as base_imponible_iva,
sum((COALESCE(gastos_clinicos, 0::double precision) + COALESCE(odontologia, 0::double precision)  + COALESCE(funerarios, 0::double precision) + COALESCE(ambulancia, 0::double precision) + COALESCE(otros, 0::double precision) + COALESCE(material, 0::double precision) + COALESCE(material_iva, 0::double precision) + COALESCE(vida, 0::double precision) + COALESCE(honorarios_medicos, 0::double precision) +  COALESCE(farmacia, 0::double precision) )) as monto_liquidado,
sum(fact.porcentaje_isrl * (COALESCE(gastos_clinicos, 0::double precision) + COALESCE(odontologia, 0::double precision)  + COALESCE(funerarios, 0::double precision) + COALESCE(ambulancia, 0::double precision) + COALESCE(otros, 0::double precision) )/100) as monto_isrl,
sum(fact.porcentaje_iva * (COALESCE(material_iva, 0::double precision) + COALESCE(ambulancia, 0::double precision)  + COALESCE(funerarios, 0::double precision) + COALESCE(otros, 0::double precision) )/100) as monto_iva,
sum(fact.porcentaje_timbre * (COALESCE(gastos_clinicos, 0::double precision) + COALESCE(odontologia, 0::double precision)  + COALESCE(funerarios, 0::double precision) + COALESCE(ambulancia, 0::double precision) + COALESCE(otros, 0::double precision) + COALESCE(material, 0::double precision) + COALESCE(material_iva, 0::double precision) + COALESCE(vida, 0::double precision) + COALESCE(honorarios_medicos, 0::double precision) +  COALESCE(farmacia, 0::double precision) )/100) as monto_timbre,
count(id_factura) AS numero_pagos
from
(select 
id_factura,
porcentaje_isrl,
porcentaje_timbre,
porcentaje_iva,
anio_siniestro 
from facturas where is_factura is true  and anio_siniestro= $P{anioSiniestro} and id_factura in ($P{idfactura}) ) fact 
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_facturagc, sum(df.monto_amparado) AS gastos_clinicos, sum(df.monto_presupuestado) AS gastos_clinicos_pres,sum(df.monto_negociado) AS gastos_clinicos_neg  
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 3 and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) gc ON fact.id_factura = gc.id_facturagc
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_facturahm, sum(df.monto_amparado) AS honorarios_medicos, sum(df.monto_presupuestado) AS honorarios_medicos_pres,sum(df.monto_negociado) AS honorarios_medicos_neg
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 6 and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) hm ON fact.id_factura = hm.id_facturahm
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_factura_mativa, sum(df.monto_amparado) AS material_iva, sum(df.monto_presupuestado) AS material_iva_pres,sum(df.monto_negociado) AS material_iva_neg  
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 9  and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) mmi ON fact.id_factura = mmi.id_factura_mativa
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_factura_mat, sum(df.monto_amparado) AS material, sum(df.monto_presupuestado) AS material_pres,sum(df.monto_negociado) AS material_neg  
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 10  and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) mm ON fact.id_factura = mm.id_factura_mat
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_factura_odo, sum(df.monto_amparado) AS odontologia, sum(df.monto_presupuestado) AS odontologia_pres,sum(df.monto_negociado) AS odontologia_neg  
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 1  and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) od ON fact.id_factura = od.id_factura_odo
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_factura_fun, sum(df.monto_amparado) AS funerarios, sum(df.monto_presupuestado) AS funerarios_pres,sum(df.monto_negociado) AS funerarios_neg  
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 2  and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) fu ON fact.id_factura = fu.id_factura_fun
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_factura_vida, sum(df.monto_amparado) AS vida, sum(df.monto_presupuestado) AS vida_pres,sum(df.monto_negociado) AS vida_neg  
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 4  and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) vid ON fact.id_factura = vid.id_factura_vida
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_factura_ambulancia, sum(df.monto_amparado) AS ambulancia, sum(df.monto_presupuestado) AS ambulancia_pres,sum(df.monto_negociado) AS ambulancia_neg  
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 5  and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) amb ON fact.id_factura = amb.id_factura_ambulancia
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_factura_farmacia, sum(df.monto_amparado) AS farmacia, sum(df.monto_presupuestado) AS farmacia_pres,sum(df.monto_negociado) AS farmacia_neg  
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 7  and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) farm ON fact.id_factura = farm.id_factura_farmacia
--**************************************************************************************    	
LEFT JOIN ( SELECT df.id_factura AS id_factura_otros, sum(df.monto_amparado) AS otros, sum(df.monto_presupuestado) AS otros_pres,sum(df.monto_negociado) AS otros_neg  
FROM detalles_factura df,tipo_gasto tg
WHERE df.id_tipo_gasto=tg.id_tipo_gasto and tg.id_tip_gas_gen = 8  and anio_siniestro=$P{anioSiniestro}
GROUP BY df.id_factura) otr ON fact.id_factura = otr.id_factura_otros ]]></queryString>

