		<columnHeader>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</columnHeader>
		<detail>
			<band height="25"  isSplitAllowed="true" >
				<textField isStretchWithOverflow="true" isBlankWhenNull="false" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="48"
						y="0"
						width="432"
						height="25"
						key="textField-6"/>
					<box></box>
					<textElement textAlignment="Justified">
						<font size="12"/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA["    Por medio de la presente cumplo en informarles que "+$V{sexo}+$F{nombre_titular}+", titular cédula de identidad número "+ ($F{nacionalidad_titular}!=null ? $F{nacionalidad_titular}+".- " : "V.- " )  +$F{cedula}+", "+$V{asegurado}+" con el FONDO AUTOADMINISTRADO DE SALUD DE LA DIRECCIÓN EJECUTIVA DE LA MAGISTRATURA, con una cobertura máxima de "+$V{coberturaLetras}+ "DE BOLÍVARES (" +$V{coberturaNumero} + ").\n\n"+
"    En virtud de lo antes expuesto LA DIRECCIÓN EJECUTIVA DE LA MAGISTRATURA, se hace responsable hasta por el monto máximo de "+$V{enLetras}+ " DE BOLÍVARES (" +$V{formatoNumero} + ") como monto único total y definitivo "+$V{autorizacion}+" por el servicio prestado de "+$F{descripcion}+ $V{beneficiario}+$F{nombre_beneficiario} +" ("+$F{parentesco}+"), titular de la cédula de identidad número "+($F{nacionalidad_beneficiario}!=null ? $F{nacionalidad_beneficiario}+".- " : "V.- " ) + " "+$F{cedula_beneficiario}+" por presentar "+$F{tratamiento}+". En fecha "+new SimpleDateFormat("dd/MM/yyyy").format(new java.sql.Date($F{fecha_notificacion}.getTime()))+" en la siguiente localidad "+ $F{proveedor}+" bajo el siniestro Nº "+$F{numero}+".\n"]]></textFieldExpression>
				</textField>
			</band>
		</detail>
