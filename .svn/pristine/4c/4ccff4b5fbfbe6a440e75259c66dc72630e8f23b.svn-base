<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="ListadoClinicasEstadoRazonable"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="552"
		 pageHeight="792"
		 columnWidth="552"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="ruta" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["C://Tomcat//webapps//fd//"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_estado" isForPrompting="true" class="java.lang.Integer"/>
	<queryString><![CDATA[select 
distinct(servicio_portal.descripcion_tipo) as servicio,estado.id_estado, ciudad.descripcion
from proveedor
inner join servicio_portal_proveedor on (proveedor.is_costo_razonable = true and proveedor.id_proveedor = servicio_portal_proveedor.id_proveedor and  servicio_portal_proveedor.is_activo = true and proveedor.is_activo = true)
inner join servicio_portal on (servicio_portal.id_serpor = servicio_portal_proveedor.id_serpor  and servicio_portal.id_serpor =2)
inner join estado on (proveedor.id_estado = estado.id_estado and proveedor.id_estado = $P{id_estado})
inner join ciudad on (proveedor.id_ciudad = ciudad.id_ciudad)
order by ciudad.descripcion,servicio_portal.descripcion_tipo]]></queryString>

	<field name="servicio" class="java.lang.String"/>
	<field name="id_estado" class="java.lang.Integer"/>
	<field name="descripcion" class="java.lang.String"/>


		<group  name="sdf" >
			<groupExpression><![CDATA[$F{descripcion}]]></groupExpression>
			<groupHeader>
