						width="552"
						height="10"
						key="subreport-1"
						isRemoveLineWhenBlank="true"/>
					<subreportParameter  name="servicio">
						<subreportParameterExpression><![CDATA[$F{servicio}]]></subreportParameterExpression>
					</subreportParameter>
					<subreportParameter  name="id_estado">
						<subreportParameterExpression><![CDATA[$F{id_estado}]]></subreportParameterExpression>
					</subreportParameter>
					<subreportParameter  name="ruta">
						<subreportParameterExpression><![CDATA[$P{ruta}]]></subreportParameterExpression>
					</subreportParameter>
					<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
					<subreportExpression  class="java.lang.String"><![CDATA[$P{ruta}+"jasper//ListadoClinicasEstadoRazonableCiudad.jasper"]]></subreportExpression>
				</subreport>
			</band>
		</detail>
		<columnFooter>
			<band height="0"  isSplitAllowed="false" >
