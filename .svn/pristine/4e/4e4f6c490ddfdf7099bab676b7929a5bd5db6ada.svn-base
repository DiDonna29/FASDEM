th {
	text-align : left;
	padding-left : 5px;
	font-family : Verdana, Tahoma, Arial;
	font-size : 7.5pt;
}

tr {
	text-align : left;
	padding : 0px;
	font-family : Verdana, Tahoma, Arial;
	font-size : 7.5pt;
}

.titulo {
	text-align : left;
	padding-left : 5px;
	font-family : Verdana, Tahoma, Arial;
	font-size : 7.5pt;
}

div.box {
	float : left;
	width : 25%;
	padding-top : 5px;
	padding-bottom : 5px;
	padding-left : 20px;
}

div.content {
	padding-top : 5px;
	padding-bottom : 5px;
}

div.titledeline {
	border-top-style : solid;
	border-top-width : 1px;
	border-top-color : #CCCCCC;
	border-bottom-style : solid;
	border-bottom-width : 1px;
	border-bottom-color : #CCCCCC;
	padding-top : 5px;
	padding-bottom : 5px;
}

th.rubro {
	text-align : left;
	font-weight : normal;
	padding-left : 10px;
	font-family : Verdana, Tahoma, Arial;
	font-size : 7.5pt;
}

.line {
	border-bottom-style : solid;
	border-bottom-width : 1px;
	border-bottom-color : #CCCCCC;
}

.delineado {
	border : 1px solid #CCCCCC;
}

.delineadoBotton {
	border-bottom : 1px solid #CCCCCC;
}

hr {
	height : 1px;
	border : 1px solid #CCCCCC;
