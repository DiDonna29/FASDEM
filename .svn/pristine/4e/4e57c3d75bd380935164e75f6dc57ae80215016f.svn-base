	<parameter name="RUTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="nombres_usuario" isForPrompting="true" class="java.lang.String"/>
	<parameter name="id" isForPrompting="true" class="java.lang.String"/>
	<parameter name="anio" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select me.fecha_inicio, me.descripcion as justificacion, s.*,upper(s.apellidos_beneficiario ||', ' || s.nombres_beneficiario)as beneficiario, 
upper(s.apellidos ||', ' || s.nombres)as titular, tt.descripcion as tipo_tratamiento,ts.descripcion as tipo_siniestro,
t.descripcion as tratamiento from siniestro s , motivo_estatus me,
patologia_organo_tratamiento pot,tipo_tratamiento tt, tipo_siniestro ts, tratamiento t
 where s.anio_siniestro=cast($P{anio} as numeric) and s.id_siniestro=cast($P{id} as numeric)
 and s.id_patologia_organo_tratamiento=pot.id_pat_org_trat_esp
 and s.id_tipo_tratamiento=tt.id_tipo_tratamiento
 and s.id_tipo_siniestro=ts.id_tipo_siniestro
 and pot.id_tratamiento=t.id_tratamiento
 and s.id_siniestro=me.id_siniestro
 and me.fecha_fin is null
 and me.id_estatus_siniestro=2]]></queryString>

