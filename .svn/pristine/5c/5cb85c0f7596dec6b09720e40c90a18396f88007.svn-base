<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap
 PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
 "http://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap namespace="Especialidad">
	<typeAlias alias="ObjEspecialidad" type="ve.gob.dem.fasdem.bean.Especialidad"/>
	<resultMap id="result_all" class="ObjEspecialidad">
		<result property="id" column="id_especialidad" jdbcType="integer"/>
		<result property="descripcion" column="descripcion" jdbcType="character varying"/>
	</resultMap>
	<sql id="sql_buscar">
		SELECT 
			id_especialidad, 
			descripcion
  		FROM 
			especialidad
			
	</sql>
	<select id="search" resultClass="ObjEspecialidad" resultMap="result_all">
		<include refid="sql_buscar"/>
		WHERE id_especialidad = #value# order by descripcion
	</select>
	<select id="list" resultClass="ObjEspecialidad" resultMap="result_all">
		<include refid="sql_buscar"/>
		order by descripcion
	</select>
	<update id="updateEspecialidad" parameterClass="map">
		UPDATE especialidad SET descripcion=#descripcion# WHERE id_especialidad=#id#
	</update>
	<insert id="insert" parameterClass="map">
        INSERT INTO especialidad(descripcion) VALUES( #descripcion#)
     </insert>
</sqlMap>
