	<parameter name="ruta" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Z:\\webapps\\portaldem\\images\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="preorden" isForPrompting="true" class="java.lang.String"/>
	<parameter name="codigo" isForPrompting="false" class="java.lang.String"/>
	<parameter name="timbre" isForPrompting="false" class="java.lang.Boolean"/>
	<queryString><![CDATA[select
aniomes_codigo || '-' || codigo_siniestro as NROSIN,
subcodigo_siniestro as NROPAG,
fecha_factura as FECFAC,
nro_factura as NROFAC,
monto_factura as MTOFAC,
monto_liquidado as MTOLIQ,
base_imponible_isrl as MTOCLI,
porcentaje_isrl AS PORISRL,
monto_isrl AS MTOISR,
monto_timbre AS MTOTMF,
base_imponible_iva AS IVACLI,
porcentaje_iva AS PORIVA,
monto_iva AS PORRIV,
monto_pagar AS MTOPAG,
proveedor.rif AS CLIBEN,
proveedor.descripcion AS BENEFI,
pre_orden_pago.codigo_completo as NRORDE,
pre_orden_pago.numero_orden as NROREF,
pre_orden_pago.fecha_orden as FECSGF,
pre_orden_pago.fecha_pagado as FECCHQ,
pre_orden_pago.aplica_timbre as aplica_timbre
from view_pagos,proveedor,pre_orden_pago
where proveedor.id_proveedor=view_pagos.id_proveedor AND
pre_orden_pago.codigo_completo=view_pagos.pre_orden and pre_orden_pago.codigo_completo=$P{preorden}]]></queryString>

	<field name="nrosin" class="java.lang.String"/>
	<field name="nropag" class="java.lang.String"/>
	<field name="fecfac" class="java.sql.Date"/>
	<field name="nrofac" class="java.lang.String"/>
	<field name="mtofac" class="java.lang.Double"/>
	<field name="mtoliq" class="java.lang.Double"/>
