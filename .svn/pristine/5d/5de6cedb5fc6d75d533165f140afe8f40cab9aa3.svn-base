	</variable>
	<variable name="TOTAL_MTO_LIQ" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtoliq}]]></variableExpression>
	</variable>
	<variable name="TOTAL_MTO_FAC" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtofac}]]></variableExpression>
	</variable>
	<variable name="ETIQUETA" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[($F{fecchq}==null)?"FINIQUITO DE PAGO":""]]></variableExpression>
	</variable>
	<variable name="tim" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[($F{aplica_timbre} == new Integer(1) ?  $F{mtotmf}: new Double(0) )]]></variableExpression>
	</variable>
