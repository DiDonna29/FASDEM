	<variable name="SINIESTRO" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[$F{nrosin}+ " " + $F{nropag}]]></variableExpression>
	</variable>
	<variable name="TOTAL_PAGAR" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtopag}]]></variableExpression>
	</variable>
	<variable name="TOTAL_RETENCIONIVA" class="java.lang.Double" resetType="Report" calculation="Nothing">
