<jasperReport
		 name="FiniquitoDePagoSinTimbre"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="792"
		 pageHeight="612"
		 columnWidth="758"
		 columnSpacing="0"
