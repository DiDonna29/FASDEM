<!DOCTYPE sqlMap
 PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
 "http://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap namespace="Factura">
	<typeAlias alias="ObjFactura" type="ve.gob.dem.fasdem.bean.Factura"/>
	<resultMap id="result_all" class="ObjFactura">
		<result property="id" column="id_Factura" jdbcType="integer"/>
		<result property="numeroFactura" column="nro_factura" jdbcType="varchar"/>
		<result property="controlFactura" column="nro_control" jdbcType="varchar"/>
		<result property="montoFactura" column="monto_total" jdbcType="numeric"/>
		<result property="porcentajeIsrl" column="porcentaje_isrl" jdbcType="numeric"/>
		<result property="porcentajeIva" column="porcentaje_iva" jdbcType="numeric"/>
		<result property="porcentajeTimbre" column="porcentaje_timbre" jdbcType="numeric"/>
		<result property="fechaFactura" column="fecha_factura" jdbcType="date"/>
		<result property="fechaRecepcionFactura" column="fecha_recepcion" jdbcType="date"/>
		<result property="isFactura" column="is_factura" jdbcType="boolean"/>
		<result property="anioSiniestro" column="anio_siniestro" jdbcType="numeric"/>
		<result property="preOrden" column="pre_orden" jdbcType="varchar"/>
		<result property="idUsuario" column="id_usuario" jdbcType="varchar"/>
	</resultMap>
	<resultMap id="result_detalle_factura" class="ObjFactura" extends="result_all">
		<result property="montoAmparado" column="monto_amparado" jdbcType="numeric"/>
		<result property="idFactura" column="id_factura" jdbcType="numeric"/>
		<result property="idDetalle" column="id_detalle" jdbcType="numeric"/>
		<result property="tipoGasto" column="id_tipo_gasto" select="TipoGasto.search"/>
		<result property="montoPresupuestado" column="monto_presupuestado" jdbcType="double"/>
		<result property="montoNegociado" column="monto_negociado" nullValue="0.0" jdbcType="double"/>
		<result property="montoNoAmparado" column="monto_no_amparado" nullValue="0.0" jdbcType="double"/>
	</resultMap>
	
	<resultMap id="result_detalle_factura_solo" class="ObjFactura" >
		<result property="montoAmparado" column="monto_amparado" jdbcType="numeric"/>
		<result property="idFactura" column="id_factura" jdbcType="numeric"/>
		<result property="idDetalle" column="id_detalle" jdbcType="numeric"/>
		<result property="tipoGasto" column="id_tipo_gasto" select="TipoGasto.search"/>
		<result property="montoPresupuestado" column="monto_presupuestado" jdbcType="double"/>
		<result property="montoNegociado" column="monto_negociado" nullValue="0.0" jdbcType="double"/>
		<result property="montoNoAmparado" column="monto_no_amparado" nullValue="0.0" jdbcType="double"/>
	</resultMap>
	
	<sql id="sql_buscar_detalles_factura">
		SELECT 
			id_detalle, 
			id_factura, 
			id_tipo_gasto, 
			monto_amparado, 
			monto_presupuestado, 
			monto_negociado, 
			monto_no_amparado
  		FROM 
			detalles_factura
			
	</sql>
	<sql id="sql_buscar">
		SELECT 
			id_factura, 
			nro_factura, 
			nro_control, 
			monto_total, 
			porcentaje_isrl,
			porcentaje_iva,
			porcentaje_timbre,
			fecha_factura,
			fecha_recepcion,
			is_factura,
			anio_siniestro,
			pre_orden,
			id_usuario
  		FROM 
			facturas
			
	</sql>
	<select id="search" resultClass="ObjFactura" resultMap="result_all">
		<include refid="sql_buscar"/>
		WHERE 
		  id_factura = #idFactura# AND 
		  anio_siniestro=#anioSiniestro#
	</select>
	<select id="searchTrue" resultClass="ObjFactura" resultMap="result_all">
		<include refid="sql_buscar"/>
		WHERE 
			anio_siniestro= #anioSiniestro# AND
			id_factura = #value# AND 
			is_factura=true
	</select>
	<select id="searchDetalle" resultClass="ObjFactura" resultMap="result_detalle_factura_solo">
		<include refid="sql_buscar_detalles_factura"/>
		WHERE 
		  anio_siniestro= #anioSiniestro# AND
		  id_factura = #idFactura# 
	</select>
	<select id="searchIdSiniestro" resultClass="ObjFactura" resultMap="result_all">
		<include refid="sql_buscar"/>
		WHERE 
		  anio_siniestro=#anioSiniestro# and 
		  id_siniestro = #idSiniestro#
	</select>
	<select id="searchIdSiniestroConsulta" resultClass="ObjFactura" resultMap="result_all">
		<include refid="sql_buscar"/>
		WHERE 
		  anio_siniestro=#anioSiniestro# AND 
		  id_siniestro = #idSiniestro#
	</select>
	<select id="searchIdSiniestroIdTipoGasto" resultClass="ObjFactura" resultMap="result_detalle_factura">
		select 
	       df.id_detalle, 
			df.id_tipo_gasto, 
			df.monto_amparado, 
			df.monto_presupuestado, 
			df.monto_negociado, 
			df.monto_no_amparado,
		  f.id_factura, 
		  f.nro_factura, 
			f.nro_control, 
			f.monto_total, 
			f.porcentaje_isrl,
			f.porcentaje_iva,
			f.porcentaje_timbre,
			f.fecha_factura,
			f.fecha_recepcion,
			f.is_factura,
			f.anio_siniestro,
			f.pre_orden,
			f.id_usuario 
	    from 
	       detalles_factura df 
		inner join 
	       facturas f  
		on 
	       df.id_factura=f.id_factura
 		where 
	       df. anio_siniestro= #anioSiniestro# and 
	       f.anio_siniestro=#anioSiniestro# and 
	       f.id_siniestro=#idSiniestro# and 
	       df.id_tipo_gasto= #idTipoGasto# and 
	       f.id_factura= #idFactura#
	</select>
	<select id="list" resultClass="ObjFactura" resultMap="result_all">
		<include refid="sql_buscar"/>
	</select>
	<select id="listDetallesFactura" resultClass="ObjFactura" resultMap="result_detalle_factura">
		select 
			id_detalle, 
			id_factura, 
			id_tipo_gasto, 
			monto_amparado, 
			monto_presupuestado, 
			monto_negociado, 
			monto_no_amparado 
		from 
			detalles_factura df
		inner join 
			facturas f
		on 
			df.id_factura=f.id_factura
		where
	        df.anio_siniestro=#anioSiniestro# and  
			id_siniestro=#idSiniestro# and 
			f.anio_siniestro=#anioSiniestro#
			<isNotEmpty property="idFactura">
				and f.id_factura= #idFactura#
			</isNotEmpty>
			<isNotEmpty property="isFactura">
				and f.is_factura= #isFactura#
			</isNotEmpty>
	</select>
	<insert id="insert" parameterClass="map">
		INSERT INTO facturas
			(nro_factura, 	nro_control, 	monto_total, 	id_siniestro, 
			 fecha_factura,		fecha_recepcion, porcentaje_isrl,porcentaje_timbre,porcentaje_iva,anio_siniestro,id_usuario)
		VALUES
			(#numeroFactura#,			#controlFactura#,		#montoFactura#,	#idSiniestro#,
			#fechaFactura#,				#fechaRecepcionFactura#,#porcentajeIsrl#,#porcentajeTimbre#,#porcentajeIva#,#anioSiniestro#,#idUsuario#)
			
		<selectKey resultClass="int" type="post" keyProperty="id">SELECT currval('facturas_id_factura_seq')</selectKey>
	</insert>


	<insert id="insertDetalle" parameterClass="map">
		INSERT INTO detalles_factura(anio_siniestro,
             monto_amparado,monto_presupuestado, monto_negociado,monto_no_amparado, id_factura,id_tipo_gasto)
    VALUES (#anioSiniestro#,#montoAmparado#,#montoPresupuestado#,#montoNegociado#, #montoNoAmparado#,#idFactura#,#idTipoGasto#)
			
		<selectKey resultClass="int" type="post" keyProperty="id">SELECT currval('detalles_factura_id_detalle_seq')</selectKey>
	</insert>

<update id="updateDetalleFactura" parameterClass="map">
		UPDATE 
            detalles_factura 
        SET 
			monto_presupuestado=#montoPresupuestado#,
			monto_amparado=#montoAmparado#,
			monto_negociado=#montoNegociado#,
			monto_no_amparado=#montoNoAmparado#
		WHERE
            anio_siniestro=#anioSiniestro# AND 
            id_detalle=#idDetalle#
		
	</update>
	<update id="updateFactura" parameterClass="map">
		UPDATE facturas SET 
		fecha_factura=#fechaFactura#,
		fecha_recepcion=#fechaRecepcionFactura#,
		nro_factura=#numeroFactura# ,
		nro_control=#controlFactura#,
		porcentaje_iva=#porcentajeIva#,
		is_factura=#isFactura#,
		monto_total=#montoFactura#,
		usuario_modificacion= #idUsuario#,
		fecha_modificacion= now()
		WHERE 
	       anio_siniestro=#anioSiniestro# AND 
	       id_factura=#idFactura#
	</update>
	<update id="updateTotalFactura" parameterClass="map">
		UPDATE facturas SET 
			monto_total=#montoPresupuestado#,
			usuario_modificacion= #idUsuario#,
			fecha_modificacion= now()
		WHERE  
			anio_siniestro=#anioSiniestro# AND  
			id_factura=#idFactura#
	</update>
	<delete id="delFactura" parameterClass="map">
		DELETE FROM facturas
		WHERE  anio_siniestro=#anioSiniestro# AND  id_factura = #idFactura#
	</delete>
	
	   <select id="validaFactura" resultClass="ObjFactura" resultMap="result_all">
		SELECT 
		  f.id_factura, 
		  f.nro_factura, 
			f.nro_control, 
			f.monto_total, 
			f.porcentaje_isrl,
			f.porcentaje_iva,
			f.porcentaje_timbre,
			f.fecha_factura,
			f.fecha_recepcion,
			f.is_factura,
			f.anio_siniestro,
			f.pre_orden,
			f.id_usuario
		FROM 
		  public.facturas f, 
		  public.siniestro s
		WHERE 
		  s.anio_siniestro = #anioSiniestro# AND
	      f.anio_siniestro = #anioSiniestro# AND    
	      s.id_siniestro = f.id_siniestro AND
		  f.nro_factura = #numeroFactura# AND          
		  f.nro_control = #controlFactura# AND 
		  s.id_proveedor = #idProveedor# AND
		  f.is_factura = true
    </select>

</sqlMap>
