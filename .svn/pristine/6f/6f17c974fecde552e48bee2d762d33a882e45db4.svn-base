package ve.gob.dem.fasdem.bean;

import java.io.Serializable;
import java.util.ArrayList;
import java.util.Date;

/**
 * @author marcenrl
 * 
 */
@SuppressWarnings("rawtypes")
public class Factura implements Serializable {
	/**
	 * 
	 */
	private static final long serialVersionUID = 5322042630096330372L;
	/**
	 * 
	 */
	private int id;
	private String siniestro;
	private int idDetalle;
	private int idFactura;
	private String numeroFactura;
	private String controlFactura;
	private ArrayList conceptos;
	private double montoAmparado;
	private double montoPresupuestado;
	private double montoNoAmparado;
	private double montoFactura;
	private ArrayList porcentajeImpuesto;
	private Date fechaFactura;
	private Date fechaRecepcionFactura;
	private TipoGasto tipoGasto;
	private double porcentajeIva;
	private double porcentajeIsrl;
	private double porcentajeTimbre;
	private double montoNegociado;
	private boolean isFactura;
	private int anioSiniestro;
	private ArrayList detalleFactura;
	private String preOrden;
	private String estatusPreOrden;
	private String idUsuario;

	public int getAnioSiniestro() {
		return anioSiniestro;
	}

	public void setAnioSiniestro(int anioSiniestro) {
		this.anioSiniestro = anioSiniestro;
	}

	public boolean isFactura() {
		return isFactura;
	}

	public void setFactura(boolean isFactura) {
		this.isFactura = isFactura;
	}

	public double getMontoNegociado() {
		return montoNegociado;
	}

	public void setMontoNegociado(double montoNegociado) {
		this.montoNegociado = montoNegociado;
	}

	public int getIdDetalle() {
		return idDetalle;
	}

	public void setIdDetalle(int idDetalle) {
		this.idDetalle = idDetalle;
	}

	public double getMontoPresupuestado() {
		return montoPresupuestado;
	}

	public void setMontoPresupuestado(double montoPresupuestado) {
		this.montoPresupuestado = montoPresupuestado;
	}

	public double getPorcentajeIva() {
		return porcentajeIva;
	}

	public void setPorcentajeIva(double porcentajeIva) {
		this.porcentajeIva = porcentajeIva;
	}

	public double getPorcentajeIsrl() {
		return porcentajeIsrl;
	}

	public void setPorcentajeIsrl(double porcentajeIsrl) {
		this.porcentajeIsrl = porcentajeIsrl;
	}

	public double getPorcentajeTimbre() {
		return porcentajeTimbre;
	}

	public void setPorcentajeTimbre(double porcentajeTimbre) {
		this.porcentajeTimbre = porcentajeTimbre;
	}

	public TipoGasto getTipoGasto() {
		return tipoGasto;
	}

	public void setTipoGasto(TipoGasto tipoGasto) {
		this.tipoGasto = tipoGasto;
	}

	public int getIdFactura() {
		return idFactura;
	}

	public void setIdFactura(int idFactura) {
		this.idFactura = idFactura;
	}

	public String getSiniestro() {
		return siniestro;
	}

	public void setSiniestro(String siniestro) {
		this.siniestro = siniestro;
	}

	public Date getFechaFactura() {
		return fechaFactura;
	}

	public void setFechaFactura(Date fechaFactura) {
		this.fechaFactura = fechaFactura;
	}

	public Date getFechaRecepcionFactura() {
		return fechaRecepcionFactura;
	}

	public void setFechaRecepcionFactura(Date fechaRecepcionFactura) {
		this.fechaRecepcionFactura = fechaRecepcionFactura;
	}

	public int getId() {
		return id;
	}

	public void setId(int id) {
		this.id = id;
	}

	public String getNumeroFactura() {
		return numeroFactura;
	}

	public void setNumeroFactura(String numeroFactura) {
		this.numeroFactura = numeroFactura;
	}

	public ArrayList getConceptos() {
		return conceptos;
	}

	public void setConceptos(ArrayList conceptos) {
		this.conceptos = conceptos;
	}

	public double getMontoAmparado() {
		return montoAmparado;
	}

	public void setMontoAmparado(double montoAmparado) {
		this.montoAmparado = montoAmparado;
	}

	public double getMontoFactura() {
		return montoFactura;
	}

	public void setMontoFactura(double montoFactura) {
		this.montoFactura = montoFactura;
	}

	public double getMontoNoAmparado() {
		return montoNoAmparado;
	}

	public void setMontoNoAmparado(double montoNoAmparado) {
		this.montoNoAmparado = montoNoAmparado;
	}

	public ArrayList getPorcentajeImpuesto() {
		return porcentajeImpuesto;
	}

	public void setPorcentajeImpuesto(ArrayList porcentajeImpuesto) {
		this.porcentajeImpuesto = porcentajeImpuesto;
	}

	public String getControlFactura() {
		return controlFactura;
	}

	public void setControlFactura(String controlFactura) {
		this.controlFactura = controlFactura;
	}

	/**
	 * @return the detalleFactura
	 */
	public ArrayList getDetalleFactura() {
		return detalleFactura;
	}

	/**
	 * @param detalleFactura
	 *            the detalleFactura to set
	 */
	public void setDetalleFactura(ArrayList detalleFactura) {
		this.detalleFactura = detalleFactura;
	}

	/**
	 * @return the serialversionuid
	 */
	public static long getSerialversionuid() {
		return serialVersionUID;
	}

	/**
	 * @return the preOrden
	 */
	public String getPreOrden() {
		return preOrden;
	}

	/**
	 * @param preOrden
	 *            the preOrden to set
	 */
	public void setPreOrden(String preOrden) {
		this.preOrden = preOrden;
	}

	/**
	 * @return the estatusPreOrden
	 */
	public String getEstatusPreOrden() {
		return estatusPreOrden;
	}

	/**
	 * @param estatusPreOrden
	 *            the estatusPreOrden to set
	 */
	public void setEstatusPreOrden(String estatusPreOrden) {
		this.estatusPreOrden = estatusPreOrden;
	}

	public void setIdUsuario(String idUsuario) {
		this.idUsuario = idUsuario;
	}

	public String getIdUsuario() {
		return idUsuario;
	}
}
