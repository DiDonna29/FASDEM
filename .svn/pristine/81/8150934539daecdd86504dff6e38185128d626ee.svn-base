<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="ListadoClinicasEstado"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="552"
		 pageHeight="792"
		 columnWidth="552"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="ruta" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["C://Tomcat//webapps//fd//"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_estado" isForPrompting="true" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(2)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
distinct(servicio_portal.descripcion_tipo) as servicio,estado.id_estado
from proveedor
inner join servicio_portal_proveedor on (proveedor.is_costo_razonable = false and proveedor.id_proveedor = servicio_portal_proveedor.id_proveedor and  servicio_portal_proveedor.is_activo = true and proveedor.is_activo = true)
inner join servicio_portal on (servicio_portal.id_serpor = servicio_portal_proveedor.id_serpor and servicio_portal.id_serpor <>1)
inner join estado on (proveedor.id_estado = estado.id_estado and proveedor.id_estado =$P{id_estado})
inner join ciudad on (proveedor.id_ciudad = ciudad.id_ciudad)
order by servicio_portal.descripcion_tipo]]></queryString>

	<field name="servicio" class="java.lang.String"/>
	<field name="id_estado" class="java.lang.Integer"/>


		<group  name="servicio" >
			<groupExpression><![CDATA[$F{servicio}]]></groupExpression>
			<groupHeader>
			<band height="0"  isSplitAllowed="true" >
			</band>
			</groupHeader>
			<groupFooter>
			<band height="0"  isSplitAllowed="false" >
			</band>
			</groupFooter>
		</group>
		<background>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</background>
		<title>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</title>
		<pageHeader>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</pageHeader>
		<columnHeader>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</columnHeader>
		<detail>
			<band height="20"  isSplitAllowed="true" >
				<rectangle>
					<reportElement
						mode="Transparent"
						x="0"
						y="0"
						width="552"
						height="10"
						key="rectangle-2"
						isPrintWhenDetailOverflows="true"/>
					<graphicElement stretchType="NoStretch"/>
				</rectangle>
				<rectangle>
					<reportElement
						mode="Transparent"
						x="0"
						y="10"
						width="552"
						height="10"
						key="rectangle-1"
						stretchType="RelativeToTallestObject"
						positionType="FixRelativeToBottom"
						isPrintWhenDetailOverflows="true"/>
					<graphicElement stretchType="RelativeToTallestObject"/>
				</rectangle>
				<subreport  isUsingCache="true">
					<reportElement
						x="0"
						y="10"
						width="552"
						height="10"
						key="subreport-1"
						isRemoveLineWhenBlank="true"
						isPrintInFirstWholeBand="true"/>
					<subreportParameter  name="servicio">
						<subreportParameterExpression><![CDATA[$F{servicio}]]></subreportParameterExpression>
					</subreportParameter>
					<subreportParameter  name="id_estado">
						<subreportParameterExpression><![CDATA[$F{id_estado}]]></subreportParameterExpression>
					</subreportParameter>
					<subreportParameter  name="ruta">
						<subreportParameterExpression><![CDATA[$P{ruta}]]></subreportParameterExpression>
					</subreportParameter>
					<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
					<subreportExpression  class="java.lang.String"><![CDATA[$P{ruta}+"jasper//ListadoClinicasEstadoCiudad.jasper"]]></subreportExpression>
				</subreport>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						mode="Opaque"
						x="0"
						y="0"
						width="552"
						height="10"
						forecolor="#FFFFFF"
						backcolor="#999999"
						key="textField-6"
						isRemoveLineWhenBlank="true"
						isPrintWhenDetailOverflows="true"/>
					<box>					<pen lineWidth="0.0" lineStyle="Solid"/>
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font fontName="Arial" pdfFontName="Helvetica-Bold" size="8" isBold="true"/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA["Tipo Servicio: " +$F{servicio}]]></textFieldExpression>
				</textField>
			</band>
		</detail>
		<columnFooter>
			<band height="0"  isSplitAllowed="false" >
			</band>
		</columnFooter>
		<pageFooter>
			<band height="0"  isSplitAllowed="false" >
			</band>
		</pageFooter>
		<summary>
