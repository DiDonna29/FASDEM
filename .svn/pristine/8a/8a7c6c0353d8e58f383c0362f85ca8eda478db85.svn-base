<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="CargaFacturasPorUsuario"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="1008"
		 pageHeight="612"
		 columnWidth="1008"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoDataSection"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="usuario" isForPrompting="true" class="java.lang.String"/>
	<parameter name="NombreUsuario" isForPrompting="true" class="java.lang.String"/>
	<parameter name="fecha" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ruta" isForPrompting="true" class="java.lang.String"/>
	<parameter name="anio" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select 
	* 
from
	(SELECT 
		siniestro.aniomes_codigo||'-'||
		siniestro.codigo_siniestro||'-'||
		siniestro.subcodigo_siniestro as siniestro,
		facturas.nro_factura,
		facturas.nro_control,
		facturas.monto_total ,
		facturas.fecha_factura,
		facturas.fecha_recepcion,
		(now()::date - facturas.fecha_recepcion) as dias,
		proveedor.descripcion, 
		to_char(now(),'dd/MM/yyyy hh:mm:ss am') as fecha_impresion,
		facturas.fecha_registro,
		facturas.id_usuario,
		coalesce(facturas.fecha_modificacion,facturas.fecha_registro) as fecha_modificacion,
		coalesce(facturas.usuario_modificacion,facturas.id_usuario) as usuario_modificacion,
		estado.descripcion as estado_proveedor,
		tipo_empleado.descripcion as tipo_empleado_beneficiario
	FROM 
		public.facturas, 
		public.siniestro, 
		public.proveedor,
		public.ciudad,
		public.estado,
		public.tipo_empleado
	WHERE 
		facturas.anio_siniestro	= $P{anio}::int AND 
		siniestro.anio_siniestro = $P{anio}::int AND
		siniestro.id_siniestro = facturas.id_siniestro AND
		siniestro.id_proveedor = proveedor.id_proveedor AND
		proveedor.id_ciudad = ciudad.id_ciudad AND
		ciudad.id_estado = estado.id_estado AND 
		siniestro.id_tipo_empleado = tipo_empleado.id_tipo_empleado) result
where

		to_char(result.fecha_modificacion, 'dd/MM/yyyy')=$P{fecha} and 
		result.usuario_modificacion=$P{usuario}]]></queryString>

	<field name="siniestro" class="java.lang.String"/>
	<field name="nro_factura" class="java.lang.String"/>
	<field name="nro_control" class="java.lang.String"/>
	<field name="monto_total" class="java.lang.Double"/>
	<field name="fecha_factura" class="java.sql.Date"/>
	<field name="fecha_recepcion" class="java.sql.Date"/>
	<field name="dias" class="java.lang.Integer"/>
	<field name="descripcion" class="java.lang.String"/>
