package ve.gob.dem.fasdem.bean;

import java.io.Serializable;

/**
 * @author marcenrl 
 * 
 */
public class Estatus implements Serializable {
	/**
	 * 
	 */
	private static final long serialVersionUID = 6205309452164699363L;
	private int id;
	private String descripcion;
	private boolean editable;
	private boolean justificacion;

	public int getId() {
		return id;
	}

	public void setId(int id) {
		this.id = id;
	}

	public String getDescripcion() {
		return descripcion;
	}

	public void setDescripcion(String descripcion) {
		this.descripcion = descripcion;
	}

	/**
	 * @return the editable
	 */
	public boolean isEditable() {
		return editable;
	}

	/**
	 * @param editable
	 *            the editable to set
	 */
	public void setEditable(boolean editable) {
		this.editable = editable;
	}

	/**
	 * @return the serialversionuid
	 */
	public static long getSerialversionuid() {
		return serialVersionUID;
	}

	public void setJustificacion(boolean justificacion) {
		this.justificacion = justificacion;
	}

	public boolean isJustificacion() {
		return justificacion;
	}
}
