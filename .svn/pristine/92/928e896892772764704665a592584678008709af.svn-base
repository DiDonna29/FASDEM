package ve.gob.dem.fasdem.bean;

import java.io.Serializable;
import java.sql.Connection;
import java.util.HashMap;

@SuppressWarnings("rawtypes")
public class Reporte implements Serializable{
	/**
	 * 
	 */
	private static final long serialVersionUID = -93034668480286139L;
	private String archivoReporte;

	private HashMap mapa;
	private Connection conexion= null;

	public Reporte(){
	}

//	M�todos gets
	public String getArchivoReporte() {
		return archivoReporte;
	}

	
	public HashMap getMapa() {
		return mapa;
	}
	
	public Connection getConexion() {
			return conexion;
		}

//	M�todos sets	
	public void setArchivoReporte(String string) {
		archivoReporte = string;
	}

	
	public void setMapa(HashMap map) {
		mapa = map;
	}

	
	

	
	public void setConexion(Connection connection) {
		conexion = connection;
	}

}
