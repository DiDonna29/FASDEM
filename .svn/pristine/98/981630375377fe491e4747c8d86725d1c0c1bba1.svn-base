	<queryString><![CDATA[SELECT 
	s.id_siniestro, 
	s.codigo_siniestro, 
	s.subcodigo_siniestro, 
	s.fecha_ocurrencia, 
	s.fecha_notificacion, 
	s.monto_presupuestado, 
	s.id_patologia_organo_tratamiento, 
	s.id_tipo_enfermedad, 
	s.id_proveedor, 
	s.id_tipo_tramite, 
	s.id_tipo_siniestro, 
        s.observacion, 
        s.id_tipo_empleado, 
        s.cedula, 
        s.fecha_nacimiento, 
        s.sexo, 
        s.cedula_beneficiario, 
        s.sexo_beneficiario, 
        s.fecha_nacimiento_beneficiario, 
	s.parentesco, 
	s.id_estatus, 
	s.nombres, 
	s.apellidos, 
	s.nombres_beneficiario, 
	s.apellidos_beneficiario, 
	s.monto_amparado, 
	s.fecha_liquidacion, 
	s.aniomes_codigo, 
	s.fecha_modificacion, 
	s.fecha_registro, 
	s.id_cobertura, 
	s.nacionalidad_titular, 
	s.nacionalidad_beneficiario, 
	s.observacion_reporte, 
	s.cita_post_operatorio, 
	s.id_tipo_tratamiento, 
	s.fecha_ingreso, 
	s.fecha_egreso, 
	s.monto_no_amparado, 
	s.anio_siniestro, 
	s.cita_pre_operatorio, 
	s.id_dependencia, 
	s.id_usuario, 
	s.monto_negociado,
	pat.descripcion as patologia,
	t.descripcion as tratamiento,
	prov.descripcion as proveedor,
	nt.observacion as nota_medica,
	nt.fecha_registro as fecha_nota,
	nt.id_usuario  as medico,
	tt.descripcion as tipo_tramite,
	nt.id_usuario as cedula_medico


FROM 
	public.siniestro s, 
	public.patologia_organo_tratamiento pot, 
	public.patologias pat, 
	public.tratamiento t, 
	public.nota_tecnica nt, 
	public.proveedor prov,
	public.tipo_tramite tt
WHERE 
	s.anio_siniestro = $P{anio}::int AND
	s.id_siniestro = $P{idSiniestro} AND
	nt.id_nota_tecnica = $P{idNotaMedica}::int AND
	s.id_tipo_tramite = tt.id_tipo_tramite AND
	pot.id_pat_org_trat_esp = s.id_patologia_organo_tratamiento AND
	pat.id_patologia = pot.id_patologia AND
	t.id_tratamiento = pot.id_tratamiento AND
	nt.id_siniestro = s.id_siniestro AND
	prov.id_proveedor = s.id_proveedor
ORDER BY 
	nt.fecha_registro desc
LIMIT 
	1 
OFFSET 
	0]]></queryString>

