	</variable>
	<variable name="TOTAL_MTOISLR" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double(  ($F{mtoisr}.doubleValue()) *($P{APLICA_ISRL}.intValue()) )]]></variableExpression>
	</variable>
