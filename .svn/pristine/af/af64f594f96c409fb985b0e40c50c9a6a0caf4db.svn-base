	</variable>
	<variable name="MTO_PAG_DET" class="java.lang.Double" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{mtoliq}.doubleValue()) - (($F{mtoisr}.doubleValue())*($P{APLICA_ISRL}.doubleValue())) - ($V{RET_IVA}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="TOTAL_HONORARIOS" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtohono}]]></variableExpression>
	</variable>
	<variable name="TOTAL_IVA" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{porriv}]]></variableExpression>
	</variable>
	<variable name="RET_IVA" class="java.lang.Double" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{porriv}.doubleValue()) *($P{POR_RETENCION}.doubleValue())/100 )]]></variableExpression>
	</variable>
	<variable name="TOTAL_RET_IVA" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{RET_IVA}]]></variableExpression>
	</variable>
