package ve.gob.dem.fasdem.bean;

import java.io.Serializable;

/**
 * @author marcenrl
 * 
 */
public class UnidadTributaria implements Serializable {
	/**
	 * 
	 */
	private static final long serialVersionUID = -8037423629143078275L;
	private int id;
	private Double monto_unidad;
	private int anio;
	private boolean activo;

	public int getId() {
		return id;
	}

	public void setId(int id) {
		this.id = id;
	}

	public Double getMonto_unidad() {
		return monto_unidad;
	}

	public void setMonto_unidad(Double montoUnidad) {
		monto_unidad = montoUnidad;
	}

	public int getAnio() {
		return anio;
	}

	public void setAnio(int anio) {
		this.anio = anio;
	}

	public static long getSerialversionuid() {
		return serialVersionUID;
	}

	public boolean isActivo() {
		return activo;
	}

	public void setActivo(boolean activo) {
		this.activo = activo;
	}
}
