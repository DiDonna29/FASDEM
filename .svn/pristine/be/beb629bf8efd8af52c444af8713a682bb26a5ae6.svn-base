	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="RUTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="nombres_usuario" isForPrompting="true" class="java.lang.String"/>
	<parameter name="id" isForPrompting="true" class="java.lang.String"/>
	<parameter name="anio" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[SELECT  s.id_siniestro, s.aniomes_codigo,to_char(age(s.fecha_registro,s.fecha_nacimiento_beneficiario),'YY') as edad_beneficiario, s.codigo_siniestro, s.subcodigo_siniestro, s.monto_presupuestado, s.monto_amparado, s.fecha_notificacion, s.fecha_ocurrencia, upper((s.apellidos::text || ', '::text) || s.nombres::text) AS titular, s.nacionalidad_titular, s.cedula AS cedula_titular, te.descripcion AS tipo_trabajador, upper((s.apellidos_beneficiario::text || ', '::text) || s.nombres_beneficiario::text) AS beneficiario, s.nacionalidad_beneficiario, s.cedula_beneficiario, s.parentesco, s.sexo_beneficiario, s.fecha_nacimiento_beneficiario, pat.descripcion AS diagnostico, t.descripcion AS tratamiento, tc.descripcion, c.monto, s.observacion, s.anio_siniestro
   FROM siniestro s
   JOIN patologia_organo_tratamiento pot ON s.id_patologia_organo_tratamiento = pot.id_pat_org_trat_esp
   JOIN tratamiento t ON pot.id_tratamiento = t.id_tratamiento
   JOIN patologias pat ON pot.id_patologia = pat.id_patologia
   JOIN cobertura c ON s.id_cobertura = c.id_cobertura
   JOIN tipo_cobertura tc ON c.id_tipo_cobertura = tc.id_tipo_cobertura
   LEFT JOIN tipo_empleado te ON s.id_tipo_empleado = te.id_tipo_empleado
where id_siniestro = cast($P{id} as numeric) and s.anio_siniestro= cast($P{anio} as numeric)]]></queryString>

