	<field name="anio_siniestro" class="java.math.BigDecimal"/>

	<variable name="monto_agotado" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{monto}.doubleValue()) -($F{monto_amparado}.doubleValue()) )]]></variableExpression>
