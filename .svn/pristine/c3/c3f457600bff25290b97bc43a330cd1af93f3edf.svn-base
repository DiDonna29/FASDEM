<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.1//EN" "http://java.sun.com/j2ee/dtds/web-jsptaglibrary_1_1.dtd">

<taglib>
  <tlibversion>1.0</tlibversion>
  <jspversion>1.1</jspversion>
  <shortname>formatoFecha</shortname>
  <tag>
        <name>formatoFecha</name>
        <tagclass>sybase.genericos.fecha.FechaTag</tagclass>
        <bodycontent>JSP</bodycontent>
        <info>
        Tag que se encarga de dar formato a una fecha en español
        </info>
          <attribute>
                <name>estilo</name>
                <required>false</required>
                <rtexprvalue>true</rtexprvalue>
          </attribute>
          <attribute>
                <name>pais</name>
                <required>false</required>
                <rtexprvalue>true</rtexprvalue>
          </attribute>
          <attribute>
                <name>hora</name>
                <required>false</required>
                <rtexprvalue>true</rtexprvalue>
          </attribute>
          <attribute>
                <name>formatoHora</name>
                <required>false</required>
                <rtexprvalue>true</rtexprvalue>
          </attribute>
          <attribute>
                <name>lenguaje</name>
                <required>false</required>
                <rtexprvalue>true</rtexprvalue>
          </attribute>
  </tag>
</taglib>





