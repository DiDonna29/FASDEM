package ve.gob.dem.fasdem.bean;

import java.io.Serializable;

/**
 * @author marcenrl
 * 
 */
public class TipoProveedor implements Serializable {

    /**
	 * 
	 */
	private static final long serialVersionUID = 3078923902000667087L;
	private int id;
    private String descripcion;
    private int id_tipo_preOrden;

    public int getId() {
	return id;
    }

    public void setId(int id) {
	this.id = id;
    }

    public String getDescripcion() {
	return descripcion;
    }

    public void setDescripcion(String descripcion) {
	this.descripcion = descripcion;
    }

	public int getId_tipo_preOrden() {
		return id_tipo_preOrden;
	}

	public void setId_tipo_preOrden(int idTipoPreOrden) {
		id_tipo_preOrden = idTipoPreOrden;
	}
}
