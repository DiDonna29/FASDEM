	/*
336500;650033;006565;003365;000065;656500;653200;650000;
*/
table.tabla {
	background-color : #EEEEEE;
	width : 100%;
}




select {
	border-color : #868686;
	border-style : solid;
	border-width : thin;
	width : 60%;

}
option {
	border : 0px;

}
textarea {
	border-color : #868686;
	border-style : solid;
	border-width : 1px;
	width : 75%;
	height : 100px;
}
input {
	border-color : #868686;
	border-style : solid;
	border-width : 1px
}
