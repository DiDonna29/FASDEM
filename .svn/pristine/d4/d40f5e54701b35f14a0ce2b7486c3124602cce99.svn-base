	<queryString><![CDATA[select distinct(estado.id_estado) , to_char(current_TIMESTAMP,'DD/MM/YYYY') as fecha_impresion from
estado, proveedor where estado.id_estado  in (7) and estado.id_estado = proveedor.id_estado
group by estado.id_estado
order by estado.id_estado]]></queryString>

