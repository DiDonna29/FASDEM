package ve.gob.dem.fasdem.bean;

import java.io.Serializable;

/**
 * @author marcenrl
 * 
 */
public class TipoGasto implements Serializable {
	/**
	 * 
	 */
	private static final long serialVersionUID = 8205180143813649454L;
	private int id;
	private String descripcion;
	private boolean iva;
	private boolean deducible;

	public int getId() {
		return id;
	}

	public void setId(int id) {
		this.id = id;
	}

	public String getDescripcion() {
		return descripcion;
	}

	public void setDescripcion(String descripcion) {
		this.descripcion = descripcion;
	}

	/**
	 * @return the iva
	 */
	public boolean isIva() {
		return iva;
	}

	/**
	 * @param iva
	 *            the iva to set
	 */
	public void setIva(boolean iva) {
		this.iva = iva;
	}

	/**
	 * @return the deducible
	 */
	public boolean isDeducible() {
		return deducible;
	}

	/**
	 * @param deducible
	 *            the deducible to set
	 */
	public void setDeducible(boolean deducible) {
		this.deducible = deducible;
	}

	/**
	 * @return the serialversionuid
	 */
	public static long getSerialversionuid() {
		return serialVersionUID;
	}
}
