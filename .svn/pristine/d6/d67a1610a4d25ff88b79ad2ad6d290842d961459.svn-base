	<parameter name="fechaInicio" isForPrompting="true" class="java.lang.String"/>
	<parameter name="fechaFin" isForPrompting="true" class="java.lang.String"/>
	<parameter name="RUTA" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[SELECT
             s.codigo_siniestro,s.subcodigo_siniestro,s.aniomes_codigo,s.cedula,s.nombres,s.apellidos,d.monto_amparado
        FROM
            siniestro s,
            facturas f,
           detalles_factura d

           WHERE
 s.id_siniestro = f.id_siniestro AND
            f.id_factura = d.id_factura AND
            s.id_tipo_tramite ='3' AND
            s.fecha_notificacion between  TO_TIMESTAMP($P{fechaInicio},'DD/MM/YYYY') 
            AND TO_TIMESTAMP($P{fechaFin},'DD/MM/YYYY')]]></queryString>

	<field name="codigo_siniestro" class="java.lang.String"/>
	<field name="subcodigo_siniestro" class="java.lang.String"/>
