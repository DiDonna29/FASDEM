package ve.gob.dem.fasdem.bean;

import java.io.Serializable;

/**
 * @author marcenrl
 * 
 */
public class DetallePreOrdenPago implements Serializable {

	/**
	 * 
	 */
	private static final long serialVersionUID = 4160599083231009724L;
	
	private String Proveedor;
	
	private Double Gastos_Clinicos;
	private Double Honorarios_Medicos;
	private Double Material_Medico_IVA;
	private Double Material_Medico;
	private Double Odontologia;
	private Double Funerarios;
	private Double Vida;
	private Double Medicinas;
	private Double Otros_Gastos;
	private Double base_imponible_isrl;
	private Double base_imponible_timbre;
	private Double monto_Liquidado;
	private Double Monto_ISRL;
	private Double Monto_Timbre;
	private Double Monto_Iva;
	private int nro_pagos;
	
	
	
	public String getProveedor() {
		return Proveedor;
	}
	public void setProveedor(String proveedor) {
		Proveedor = proveedor;
	}
	public Double getBase_imponible_isrl() {
		return base_imponible_isrl;
	}
	public void setBase_imponible_isrl(Double baseImponibleIsrl) {
		base_imponible_isrl = baseImponibleIsrl;
	}
	public Double getBase_imponible_timbre() {
		return base_imponible_timbre;
	}
	public void setBase_imponible_timbre(Double baseImponibleTimbre) {
		base_imponible_timbre = baseImponibleTimbre;
	}
	
	public Double getMonto_Liquidado() {
		return monto_Liquidado;
	}
	public void setMonto_Liquidado(Double montoLiquidado) {
		monto_Liquidado = montoLiquidado;
	}
	public Double getMonto_ISRL() {
		return Monto_ISRL;
	}
	public void setMonto_ISRL(Double montoISRL) {
		Monto_ISRL = montoISRL;
	}
	public Double getMonto_Timbre() {
		return Monto_Timbre;
	}
	public void setMonto_Timbre(Double montoTimbre) {
		Monto_Timbre = montoTimbre;
	}
	public Double getMonto_Iva() {
		return Monto_Iva;
	}
	public void setMonto_Iva(Double montoIva) {
		Monto_Iva = montoIva;
	}
	public int getNro_pagos() {
		return nro_pagos;
	}
	public void setNro_pagos(int nroPagos) {
		nro_pagos = nroPagos;
	}
	public static long getSerialversionuid() {
		return serialVersionUID;
	}
	public Double getGastos_Clinicos() {
		return Gastos_Clinicos;
	}
	public void setGastos_Clinicos(Double gastosClinicos) {
		Gastos_Clinicos = gastosClinicos;
	}
	public Double getHonorarios_Medicos() {
		return Honorarios_Medicos;
	}
	public void setHonorarios_Medicos(Double honorariosMedicos) {
		Honorarios_Medicos = honorariosMedicos;
	}
	public Double getMedicinas() {
		return Medicinas;
	}
	public void setMedicinas(Double medicinas) {
		Medicinas = medicinas;
	}
	public Double getOtros_Gastos() {
		return Otros_Gastos;
	}
	public void setOtros_Gastos(Double otrosGastos) {
		Otros_Gastos = otrosGastos;
	}
	public Double getMaterial_Medico_IVA() {
		return Material_Medico_IVA;
	}
	public void setMaterial_Medico_IVA(Double materialMedicoIVA) {
		Material_Medico_IVA = materialMedicoIVA;
	}
	public Double getMaterial_Medico() {
		return Material_Medico;
	}
	public void setMaterial_Medico(Double materialMedico) {
		Material_Medico = materialMedico;
	}
	public Double getOdontologia() {
		return Odontologia;
	}
	public void setOdontologia(Double odontologia) {
		Odontologia = odontologia;
	}
	public Double getFunerarios() {
		return Funerarios;
	}
	public void setFunerarios(Double funerarios) {
		Funerarios = funerarios;
	}
	public Double getVida() {
		return Vida;
	}
	public void setVida(Double vida) {
		Vida = vida;
	}


	
}
