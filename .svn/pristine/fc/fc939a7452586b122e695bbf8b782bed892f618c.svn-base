package ve.gob.dem.fasdem.bean;

import java.io.Serializable;

/**
 * @author barrjime
 * 
 */

public class Impuesto implements Serializable{
	
	private static final long serialVersionUID =8205180143813649454L;
	private int id;
	private int id_tipo_impuesto;
	private String descripcion;
	private double monto;
	private int estatus;
	
	
	public int getId() {
		return id;
	}
	public void setId(int id_impuesto) {
		this.id = id;
	}
	public int getId_tipo_impuesto() {
		return id_tipo_impuesto;
	}
	public void setId_tipo_impuesto(int id_tipo_impuesto) {
		this.id_tipo_impuesto = id_tipo_impuesto;
	}
	public double getMonto() {
		return monto;
	}
	public void setMonto(double monto) {
		this.monto = monto;
	}
	public int getEstatus() {
		return estatus;
	}
	public void setEstatus(int estatus) {
		this.estatus = estatus;
	}
	public String getDescripcion() {
		return descripcion;
	}
	public void setDescripcion(String descripcion) {
		this.descripcion = descripcion;
	}
	
	
	

}
