<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap
 PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
 "http://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap namespace="EstatusTipoTramite">
	<typeAlias alias="ObjEstatusTipoTramite" type="ve.gob.dem.fasdem.bean.EstatusTipoTramite"/>
	<resultMap id="result_all" class="ObjEstatusTipoTramite">
		<result property="id" column="id_tipo_estatus_tipo_tramite" jdbcType="integer"/>
		<result property="idEstatus" column="id_estatus_siniestro" jdbcType="integer"/>
		<result property="idTipoTramite" column="id_tipo_tramite" jdbcType="integer"/>
		<result property="reporte" column="reporte" jdbcType="character varying"/>
		
	</resultMap>

	<sql id="sql_buscar">
		SELECT 
			id_tipo_estatus_tipo_tramite,
			id_estatus_siniestro,
			id_tipo_tramite,
			reporte
  		FROM 
			tipo_estatus_tipo_tramite
	</sql>

	<select id="searchByEstatusTipoTramite" resultClass="ObjEstatusTipoTramite"  resultMap="result_all">
		<include refid="sql_buscar"/>
		WHERE id_estatus_siniestro = #idEstatus#
		and id_tipo_tramite=#idTipoTramite#
	</select>

	
	
	

</sqlMap>

	
	
