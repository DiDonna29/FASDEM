<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap
 PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
 "http://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap namespace="Medicamento">
	<typeAlias alias="ObjMedicamento" type="ve.gob.dem.fasdem.bean.Medicamento"/>
	<resultMap id="result_medicamento" class="ObjMedicamento">
		<result property="medicamento" column="medicamento" jdbcType="varchar"/>
		<result property="posologia" column="posologia" jdbcType="VARCHAR"/>
		<result property="idRecipe" column="recipe" jdbcType="NUMBER"/>
		<result property="idMedicamento" column="id_medicamento" jdbcType="NUMBER"/>
	</resultMap>
	<sql id="sql_buscar">SELECT medicamento, posologia, recipe, id_medicamento FROM medicamentos </sql>
	<select id="searchRecipes" resultClass="ObjMedicamento" resultMap="result_medicamento">
		<include refid="sql_buscar"/>
		WHERE recipe = #value# ::int  
	</select>
	<select id="searchmedica" resultClass="ObjMedicamento" resultMap="result_medicamento">
		<include refid="sql_buscar"/>
		WHERE id_medicamento = #value# 
	</select>
</sqlMap>
