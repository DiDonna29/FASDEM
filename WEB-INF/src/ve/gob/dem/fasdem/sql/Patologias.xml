<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap
 PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
 "http://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap namespace="Patologias">
	<typeAlias alias="ObjPatologias" type="ve.gob.dem.fasdem.bean.Patologias"/>
	<resultMap id="result_all" class="ObjPatologias">
		<result property="id" column="id_patologia" jdbcType="integer"/>
		<result property="descripcion" column="descripcion" jdbcType="character varying"/>
	</resultMap>
	<sql id="sql_buscar">
		SELECT 
			id_patologia, 
			descripcion
  		FROM 
			patologias
			
	</sql>
	<select id="search" resultClass="ObjPatologias" resultMap="result_all">
		<include refid="sql_buscar"/>
		WHERE id_patologia = #value#
	</select>
	<select id="list" resultClass="ObjPatologias" resultMap="result_all">
		<include refid="sql_buscar"/>
		order by descripcion
	</select>
	<select id="porOrganoEspecialidad" parameterClass="map" resultClass="ObjPatologias" resultMap="result_all">
		SELECT 
			distinct(pot.id_patologia) as id_patologia,
			p.descripcion
		FROM 
			public.patologia_organo_tratamiento pot, 
			public.patologias p
		WHERE
	        pot.id_especialidad = #idEspecialidad#::int AND
	        pot.id_organo= #idOrgano#::int AND 
			p.id_patologia = pot.id_patologia AND
			
			pot.is_activo=TRUE 
			
		order by descripcion
	</select>
	<update id="updatePatologia" parameterClass="map">
		UPDATE patologias SET descripcion=#descripcion# WHERE id_patologia=#id#
	</update>
	<insert id="insert" parameterClass="map">
        INSERT INTO patologias(descripcion) VALUES( #descripcion#)
     </insert>
</sqlMap>
