<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap
 PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
 "http://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap namespace="UbicacionFisica">
	<typeAlias alias="ObjUbicacionFisica" type="ve.gob.dem.fasdem.bean.UbicacionFisica"/>
	<resultMap id="result_all" class="ObjUbicacionFisica">
		<result property="id" column="id_ubicacion_fisica" jdbcType="integer"/>
		<result property="descripcion" column="descripcion" jdbcType="VARCHAR2"/>
	</resultMap>

	<sql id="sql_buscar">
		SELECT 
			id_ubicacion_fisica,
			descripcion
  		FROM 
			Ubicacion_fisica
			
	</sql>

	<select id="search" resultClass="ObjUbicacionFisica" resultMap="result_all">
		<include refid="sql_buscar"/>
		WHERE id_ubicacion_fisica = #value#
	</select>
</sqlMap>

	
	
