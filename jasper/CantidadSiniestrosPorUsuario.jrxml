<?xml version="1.0" encoding="UTF-8"  ?>
<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="CantidadSiniestrosPorUsuario"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="1110"
		 pageHeight="612"
		 columnWidth="1110"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoDataSection"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.zoom" value="1.0" />
	<property name="ireport.x" value="0" />
	<property name="ireport.y" value="0" />
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="usuario" isForPrompting="true" class="java.lang.String"/>
	<parameter name="NombreUsuario" isForPrompting="true" class="java.lang.String"/>
	<parameter name="fecha" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ruta" isForPrompting="true" class="java.lang.String"/>
	<parameter name="anio" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select
siniestro.id_siniestro,
siniestro.id_proveedor,
siniestro.id_usuario_liq,
cedula,
nombres,
apellidos,
aniomes_codigo||'-'||codigo_siniestro||'-'||subcodigo_siniestro as codigo_completo,
tipo_tramite.descripcion as tipo_tramite,
tipo_empleado.descripcion as tipo_empleado,
codigo_siniestro,
subcodigo_siniestro,
aniomes_codigo,
estatus_siniestro.descripcion as estatus,
tipo_siniestro.descripcion as tipo_siniestro,
nombres_beneficiario ||' '|| apellidos_beneficiario as nombres_beneficiario,
tipo_proveedor.descripcion as tipo_proveedor,
proveedor.descripcion as nombre_proveedor,
siniestro.fecha_modificacion,
to_char(siniestro.fecha_registro, 'DD/MM/YYYY') as fecha_registro,
siniestro.id_usuario, to_char(current_TIMESTAMP,'DD/MM/YYYY HH:mm:ss am') as fecha_impresion,
monto_amparado as monto,
facturas.nro_factura as numero_factura,
(select descripcion from estado where id_estado=(select id_estado from proveedor where id_proveedor=siniestro.id_proveedor)) estado
from
siniestro
INNER JOIN estatus_siniestro ON (siniestro.anio_siniestro  = $P{anio}::int and id_usuario_liq=$P{usuario} and to_char(fecha_liquidacion, 'DD/MM/YYYY') = $P{fecha} and   siniestro.id_estatus = estatus_siniestro.id_estatus_siniestro)
INNER JOIN tipo_tramite ON (siniestro.id_tipo_tramite=tipo_tramite.id_tipo_tramite)
INNER JOIN tipo_siniestro ON (siniestro.id_tipo_siniestro = tipo_siniestro.id_tipo_siniestro)
INNER JOIN proveedor ON (siniestro.id_proveedor = proveedor.id_proveedor )
INNER JOIN tipo_proveedor on (proveedor.id_tipo_proveedor= tipo_proveedor.id_tipo_proveedor)
INNER JOIN tipo_empleado on (siniestro.id_tipo_empleado= tipo_empleado.id_tipo_empleado)
INNER JOIN facturas on (siniestro.id_siniestro= facturas.id_siniestro)
order by tipo_tramite,tipo_siniestro]]></queryString>

