<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="CartaAval"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="612"
		 pageHeight="792"
		 columnWidth="552"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="54"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="RUTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="descripcion_usuario" isForPrompting="true" class="java.lang.String"/>
	<parameter name="id" isForPrompting="true" class="java.lang.String"/>
	<parameter name="anio" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[SELECT te.descripcion as tipo_trabajador, s.cita_post_operatorio ,s.id_siniestro, s.aniomes_codigo, 
s.codigo_siniestro, s.subcodigo_siniestro, s.fecha_notificacion, p.descripcion AS proveedor, 
p.direccion, p.rif, p.telefono, upper((s.apellidos::text || ', '::text) || s.nombres::text) 
AS titular, s.nacionalidad_titular, s.cedula AS cedula_titular, te.descripcion AS 
tipo_trabajador, upper((s.apellidos_beneficiario::text || ', '::text) || s.nombres_beneficiario::text) 
AS beneficiario, s.nacionalidad_beneficiario,to_char(age (s.fecha_registro, s.fecha_nacimiento_beneficiario),'YYY')::int 
AS edad_beneficiario, s.cedula_beneficiario, s.parentesco, s.sexo_beneficiario, s.fecha_nacimiento_beneficiario, 
pat.descripcion AS diagnostico, t.descripcion AS tratamiento, s.monto_negociado,  s.monto_negociado - s.monto_amparado
 AS monto_no_amparado, s.monto_amparado,a.monto_maximo_autorizado as monto_autorizado, s.observacion
   FROM siniestro s
   JOIN patologia_organo_tratamiento pot ON s.id_patologia_organo_tratamiento = pot.id_pat_org_trat_esp
   JOIN tratamiento t ON pot.id_tratamiento = t.id_tratamiento
   JOIN proveedor p ON s.id_proveedor = p.id_proveedor
   LEFT JOIN tipo_empleado te ON s.id_tipo_empleado = te.id_tipo_empleado
   JOIN patologias pat ON pot.id_patologia = pat.id_patologia 
   LEFT JOIN autorizacion a on s.id_siniestro=a.id_siniestro
   WHERE s.id_tipo_tramite=2 and s.anio_siniestro=cast($P{anio} as numeric) and s.id_siniestro=cast($P{id} as numeric)]]></queryString>

