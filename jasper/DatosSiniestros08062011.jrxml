<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="DatosSiniestros08062011"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="3749"
		 pageHeight="595"
		 columnWidth="3749"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false"
		 isIgnorePagination="true">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="ruta" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Z:\\webapps\\fasdem\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="anio" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(2011)]]></defaultValueExpression>
	</parameter>
	<parameter name="mes" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(3)]]></defaultValueExpression>
	</parameter>
	<parameter name="tipo_tramite" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
cast(id_factura as character varying),  
nro_factura,  
monto_total,  
siniestro.id_siniestro,  
to_char(fecha_factura, 'DD/MM/YYYY') as fecha_factura,  
siniestro.id_proveedor,  
cedula,
nombres,
apellidos,  
aniomes_codigo||codigo_siniestro||subcodigo_siniestro as codigo_completo,  
tipo_tramite.descripcion as tipo_tramite,  
tipo_empleado.descripcion as id_tipo_empleado,  
codigo_siniestro,  
subcodigo_siniestro,  
aniomes_codigo,  
pre_orden,  
estatus_siniestro.descripcion as estatus,
tipo_siniestro.descripcion as tipo_siniestro, 
nro_control,
fecha_recepcion,
nombres ||' '|| apellidos as nombres_titular,
nombres_beneficiario ||' '|| apellidos_beneficiario as nombres_beneficiario,
tipo_proveedor.descripcion as tipo_proveedor,
proveedor.descripcion as nombre_proveedor,
to_char(fecha_modificacion, 'DD/MM/YYYY') as fecha_modificacion, 
to_char(siniestro.fecha_registro, 'DD/MM/YYYY') as fecha_registro, 
facturas.id_usuario, especialidad.descripcion as especialidad,
tratamiento.descripcion as tratamiento,
patologias.descripcion as patologia,
siniestro.id_tipo_tramite  
from 
siniestro 
left JOIN facturas ON (siniestro.anio_siniestro = $P{anio} and substr(siniestro.aniomes_codigo, 3)::int = $P{mes}  and siniestro.anio_siniestro= facturas.anio_siniestro and siniestro.id_siniestro=facturas.id_siniestro and is_factura is true)
INNER JOIN estatus_siniestro ON (siniestro.id_estatus = estatus_siniestro.id_estatus_siniestro)
INNER JOIN tipo_tramite ON (siniestro.id_tipo_tramite=tipo_tramite.id_tipo_tramite and siniestro.id_tipo_tramite=$P{tipo_tramite})
INNER JOIN tipo_siniestro ON (siniestro.id_tipo_siniestro = tipo_siniestro.id_tipo_siniestro) 
INNER JOIN proveedor ON (siniestro.id_proveedor = proveedor.id_proveedor )
INNER JOIN tipo_proveedor on (proveedor.id_tipo_proveedor= tipo_proveedor.id_tipo_proveedor)
INNER JOIN tipo_empleado on (siniestro.id_tipo_empleado= tipo_empleado.id_tipo_empleado)
INNER JOIN patologia_organo_tratamiento ON (siniestro.id_patologia_organo_tratamiento= patologia_organo_tratamiento.id_pat_org_trat_esp)
INNER JOIN especialidad ON (patologia_organo_tratamiento.id_especialidad = especialidad.id_especialidad)
INNER JOIN organo ON (patologia_organo_tratamiento.id_organo = organo.id_organo)
INNER JOIN patologias ON (patologia_organo_tratamiento.id_patologia = patologias.id_patologia)
INNER JOIN tratamiento ON (patologia_organo_tratamiento.id_tratamiento = tratamiento.id_tratamiento)
order by id_factura]]></queryString>

