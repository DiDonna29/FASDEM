	<parameter name="IVA" isForPrompting="false" class="java.lang.Double"/>
	<parameter name="LIQUIDADO" isForPrompting="false" class="java.lang.Double"/>
	<parameter name="ISRL" isForPrompting="false" class="java.lang.Double"/>
	<parameter name="TIMBRE" isForPrompting="false" class="java.lang.Double"/>
	<parameter name="RETENCION" isForPrompting="false" class="java.lang.Double"/>
	<parameter name="POR_RETENCION" isForPrompting="false" class="java.lang.Double"/>
	<parameter name="PAGAR" isForPrompting="false" class="java.lang.Double"/>
	<parameter name="USUARIO" isForPrompting="false" class="java.lang.String"/>
	<parameter name="HOJA" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select * from (select 
numero,(select nombres||' '||apellidos from facturas, siniestro 
				where 
					facturas.anio_siniestro = pre_orden_pago.anio_preordenpago 
					and siniestro.anio_siniestro = pre_orden_pago.anio_preordenpago
					and facturas.pre_orden like pre_orden_pago.pre_orden
					and facturas.id_siniestro=siniestro.id_siniestro::int
					limit 1)
			
AS PROVEEDOR,
monto_pre_orden,causado, hoja_ruta.fecha,tipo_hoja_ruta.descripcion AS OBSERVACION,periodo_fiscal,id_beneficiario
from hoja_ruta_preorden,hoja_ruta,pre_orden_pago,proveedor,tipo_hoja_ruta
where hoja_ruta.id_hoja_ruta=hoja_ruta_preorden.id_hoja_ruta 
and pre_orden_pago.id_pre_orden=hoja_ruta_preorden.id_preorden 
and pre_orden_pago.anio_preordenpago=hoja_ruta_preorden.anio_preorden
and proveedor.id_proveedor=pre_orden_pago.id_proveedor and tipo_hoja_ruta.id_tipo_hoja_ruta=hoja_ruta.tipo_hoja and hoja_ruta_preorden.id_hoja_ruta=$P{HOJA}::int
) as d
LEFT JOIN ( SELECT sf.cuenta AS cuenta, cedula
FROM view_cuentas_sigefirrhh sf ) sf1 ON sf1.cedula = d.id_beneficiario]]></queryString>

	<field name="numero" class="java.lang.String"/>
