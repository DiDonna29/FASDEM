<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="SolicitudRecaudoCarta"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="612"
		 pageHeight="792"
		 columnWidth="442"
		 columnSpacing="0"
		 leftMargin="85"
		 rightMargin="85"
		 topMargin="70"
		 bottomMargin="70"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="RUTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="descripcion_usuario" isForPrompting="true" class="java.lang.String"/>
	<parameter name="id" isForPrompting="true" class="java.lang.String"/>
	<parameter name="anio" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select me.fecha_inicio, me.descripcion as justificacion, s.*,upper(s.apellidos_beneficiario ||', ' || s.nombres_beneficiario)as beneficiario, 
upper(s.apellidos ||', ' || s.nombres)as titular, s.cedula as cedula_sin, tt.descripcion as tipo_tratamiento,ts.descripcion as tipo_siniestro,
t.descripcion as tratamiento, c.cedula as cedula_banco, c.cuenta as cuenta, c.banco as banco from siniestro s , motivo_estatus me,
patologia_organo_tratamiento pot,tipo_tratamiento tt, tipo_siniestro ts, tratamiento t, view_cuentas c
 where s.anio_siniestro=cast($P{anio} as numeric) and s.id_siniestro=cast($P{id} as numeric)
 and s.id_patologia_organo_tratamiento=pot.id_pat_org_trat_esp
 and s.id_tipo_tratamiento=tt.id_tipo_tratamiento
 and s.id_tipo_siniestro=ts.id_tipo_siniestro
 and pot.id_tratamiento=t.id_tratamiento
 and s.id_siniestro=me.id_siniestro
 and me.fecha_fin is null
 and c.cedula=cast(s.cedula as numeric)
 and me.id_estatus_siniestro=2]]></queryString>

