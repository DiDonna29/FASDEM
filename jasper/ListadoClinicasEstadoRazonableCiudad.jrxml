	<parameter name="ruta" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["C://Tomcat//webapps//fd//"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_estado" isForPrompting="true" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="servicio" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Clinicas"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
distinct(servicio_portal.descripcion_tipo) as servicio,estado.id_estado, proveedor.id_ciudad
from proveedor
inner join servicio_portal_proveedor on (proveedor.is_costo_razonable = true and proveedor.id_proveedor = servicio_portal_proveedor.id_proveedor and  servicio_portal_proveedor.is_activo = true and proveedor.is_activo = true)
inner join servicio_portal on (servicio_portal.id_serpor = servicio_portal_proveedor.id_serpor and servicio_portal.id_serpor <>1 and servicio_portal.descripcion_tipo = $P{servicio})
inner join estado on (proveedor.id_estado = estado.id_estado and proveedor.id_estado = $P{id_estado})
inner join ciudad on (proveedor.id_ciudad = ciudad.id_ciudad and ciudad.id_estado = estado.id_estado  )
order by servicio_portal.descripcion_tipo, proveedor.id_ciudad]]></queryString>

	<field name="servicio" class="java.lang.String"/>
	<field name="id_estado" class="java.lang.Integer"/>
	<field name="id_ciudad" class="java.lang.Integer"/>

