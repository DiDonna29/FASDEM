	<parameter name="id_siniestro" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(866601)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select nro_factura, fecha_factura,sum (monto_amparado) as monto_amparado from detalles_factura df,facturas f where 
df.id_factura=f.id_factura and 
f.id_siniestro=$P{id_siniestro} group by f.id_factura,nro_factura,fecha_factura]]></queryString>

	<field name="nro_factura" class="java.lang.String"/>
