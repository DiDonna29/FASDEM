<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="NotadeCoberturaRmbls_BCK"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="anio" isForPrompting="true" class="java.lang.String"/>
	<parameter name="id" isForPrompting="true" class="java.lang.String"/>
	<parameter name="descripcion_usuario" isForPrompting="false" class="java.lang.String"/>
	<parameter name="RUTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[$P{RUTA}]]></defaultValueExpression>
	</parameter>
	<parameter name="cuenta" isForPrompting="true" class="java.lang.String"/>
	<parameter name="id_dependencia" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select 
	amparado.*,
	no_amparado.noamp_idfactura,
	no_amparado.id_tipo_gasto, 
	no_amparado.id_detalle, 
	coalesce(no_amparado.monto_noamparado, 0) as monto_noamparado
from 
	(SELECT 
		dc.id,dc.descripcion as dependencia,
		s.aniomes_codigo,
		s.codigo_siniestro, 
		s.subcodigo_siniestro, 
		s.fecha_ocurrencia, 
		s.fecha_notificacion, 
		s.fecha_liquidacion,
		s.cedula_beneficiario, 
		s.cedula, 
		s.nombres || ' ' ||s.apellidos as titular, 
		s.nombres_beneficiario || ' ' || s.apellidos_beneficiario as beneficiario, 
		s.parentesco, 
		s.fecha_ingreso, 
		s.sexo_beneficiario, 
		s.fecha_nacimiento_beneficiario,
		s.anio_siniestro::text as anio,
		s.monto_amparado as total_amparado,	
		p.descripcion || ' - '||t.descripcion as tratamiento, 
		tt.descripcion as tipo_tramite, 
		ts.descripcion as tipo_siniestro, 
		mot_est.descripcion as observacion, 
		te.descripcion as tipo_empleado, 
		f.nro_factura, 
		f.nro_control, 
		f.monto_total, 
		f.fecha_factura, 
		f.fecha_recepcion, 
		f.is_factura, 
		f.id_factura::text as id_fact,
		f.id_factura,
		df.id_tipo_gasto, 
		df.id_detalle, 
		df.anio_siniestro, 
		df.monto_amparado,   
		tg.descripcion,
		tg.deducible,
		df.monto_amparado as monto_facturado,
		prov.descripcion as proveedor
	FROM 
		public.siniestro s, 
		public.patologia_organo_tratamiento pot, 
		public.patologias p, 
		public.tratamiento t, 
		public.tipo_tramite tt, 
		public.tipo_siniestro ts, 
		public.tipo_empleado te,
		public.detalles_factura df, 
		public.facturas f, 
		public.tipo_gasto tg,
		public.proveedor prov,
		public.motivo_estatus mot_est,
		public.dependencia dc
	WHERE 
		s.anio_siniestro =cast ($P{anio} as numeric) AND
		s.id_siniestro = cast ($P{id} as numeric) AND
		dc.id = cast($P{id_dependencia} as numeric)  AND
		tg.id_tipo_gasto!=34 AND
		tg.id_tipo_gasto!=35 AND
		s.anio_siniestro = df.anio_siniestro AND
		s.anio_siniestro = f.anio_siniestro AND    
		s.id_proveedor = prov.id_proveedor AND
		s.id_tipo_empleado = te.id_tipo_empleado AND
		s.id_patologia_organo_tratamiento = pot.id_pat_org_trat_esp  AND
		s.id_tipo_tramite = tt.id_tipo_tramite AND
		s.id_tipo_siniestro  = ts.id_tipo_siniestro AND
		s.id_siniestro = f.id_siniestro AND
		s.id_estatus  = mot_est.id_estatus_siniestro AND
		s.id_siniestro=mot_est.id_siniestro AND
		pot.id_patologia  = p.id_patologia  AND
		pot.id_tratamiento = t.id_tratamiento AND
		f.id_factura = df.id_factura AND
		tg.id_tipo_gasto = df.id_tipo_gasto AND
		mot_est.fecha_fin is null ) as amparado
LEFT JOIN
	(SELECT 
		f.id_factura as noamp_idfactura,
		df.id_tipo_gasto, 
		df.id_detalle, 
		df.monto_amparado as monto_noamparado
	FROM 
		public.siniestro s, 
		public.detalles_factura df, 
		public.facturas f, 
		public.tipo_gasto tg
	WHERE 
		s.anio_siniestro 	= cast ($P{anio} as numeric) AND
		df.anio_siniestro 	= cast ($P{anio} as numeric)AND
		f.anio_siniestro 	= cast ($P{anio} as numeric) AND    
		s.id_siniestro 		= cast ($P{id} as numeric) AND
		tg.id_tipo_gasto	!=34 AND
		tg.id_tipo_gasto	=35 AND
		s.id_siniestro 		= f.id_siniestro AND
		f.id_factura 		= df.id_factura AND
		tg.id_tipo_gasto = df.id_tipo_gasto 
	ORDER BY 
		s.id_siniestro, 
		f.id_factura, 
		tg.id_tipo_gasto) as no_amparado
ON
amparado.id_factura = no_amparado.noamp_idfactura]]></queryString>

