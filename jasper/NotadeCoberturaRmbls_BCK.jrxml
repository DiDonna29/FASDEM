	<variable name="edad_bene" class="java.lang.Integer" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new Integer($F{fecha_notificacion}.getYear() - $F{fecha_nacimiento_beneficiario}.getYear())]]></variableExpression>
	</variable>
	<variable name="total_general" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[( $F{deducible}!=new Boolean(true) ? $F{monto_amparado} : new Double(0.0) )]]></variableExpression>
	</variable>
	<variable name="enLetras" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new ve.gob.dem.reportes.utilidades.NumerosLetras().convertirLetras($F{total_amparado}.toString())]]></variableExpression>
	</variable>
	<variable name="formatoNumero" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new ve.gob.dem.reportes.utilidades.FormatoNumeros().formatoNumero($F{total_amparado}.toString())]]></variableExpression>
	</variable>
	<variable name="verdaderofalso" class="java.lang.Boolean" resetType="Report" calculation="Nothing">
		<initialValueExpression><![CDATA[new Boolean (false)]]></initialValueExpression>
	</variable>
	<variable name="total_facturado" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_total}]]></variableExpression>
	</variable>
	<variable name="total_amparado" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_amparado}]]></variableExpression>
	</variable>
	<variable name="total_noamparado" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_noamparado}]]></variableExpression>
	</variable>

