	<parameter name="id_factura" isForPrompting="true" class="java.lang.String"/>
	<parameter name="anio" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select tg.descripcion,tg.deducible,CASE WHEN tg.id_tipo_gasto<>35 THEN df.monto_amparado
            ELSE 0
       END as monto_amparado,
       CASE WHEN tg.id_tipo_gasto=35 THEN df.monto_amparado
            ELSE 0
       END as monto_no_amparado,
       df.monto_amparado as monto_facturado from facturas f, detalles_factura df , tipo_gasto tg 
where df.id_factura=cast ($P{id_factura} as numeric) and df.anio_siniestro=cast ($P{anio} as numeric) and df.id_tipo_gasto=tg.id_tipo_gasto
and df.id_factura=f.id_factura and f.anio_siniestro=cast ($P{anio} as numeric)]]></queryString>

	<field name="descripcion" class="java.lang.String"/>
	<field name="deducible" class="java.lang.Boolean"/>
	<field name="monto_amparado" class="java.lang.Double"/>
	<field name="monto_no_amparado" class="java.lang.Double"/>
	<field name="monto_facturado" class="java.lang.Double"/>

	<variable name="total_facturado" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_facturado}]]></variableExpression>
	</variable>
	<variable name="total_amparado" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_amparado}]]></variableExpression>
	</variable>
	<variable name="total_no_amparado" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_no_amparado}]]></variableExpression>
	</variable>
	<variable name="enLetras" class="java.lang.String" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new ve.gob.dem.reportes.utilidades.NumerosLetras().convertirLetras($V{total_amparado}.toString())]]></variableExpression>
	</variable>
	<variable name="formatoNumero2" class="java.lang.String" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new ve.gob.dem.reportes.utilidades.FormatoNumeros().formatoNumero($V{total_amparado}.toString())]]></variableExpression>
	</variable>
	<variable name="monto_factura" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[(new java.lang.Double(0).equals($F{monto_amparado})?$F{monto_no_amparado}:$F{monto_amparado})]]></variableExpression>
	</variable>
