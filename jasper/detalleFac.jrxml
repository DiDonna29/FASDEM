	<field name="vida" class="java.lang.Double"/>
	<field name="medicinas" class="java.lang.Double"/>
	<field name="otros" class="java.lang.Double"/>
	<field name="monto_iva" class="java.lang.Double"/>
	<field name="base_imponible_isrl" class="java.lang.Double"/>
	<field name="monto_liquidado" class="java.lang.Double"/>
	<field name="monto_isrl" class="java.lang.Double"/>
	<field name="monto_timbre" class="java.lang.Double"/>
	<field name="numero_pagos" class="java.lang.Long"/>

	<variable name="total_amparado" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{gastos_clinicos}.doubleValue()) +($F{honorarios_medicos}.doubleValue())+($F{material_iva}.doubleValue())+($F{material}.doubleValue())+($F{odontologia}.doubleValue())+($F{funerarios}.doubleValue())+($F{vida}.doubleValue())+($F{medicinas}.doubleValue())+($F{otros}.doubleValue()))
]]></variableExpression>
	</variable>
