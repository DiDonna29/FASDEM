	<queryString><![CDATA[SELECT 
  df.monto_amparado, 
  df.id_tipo_gasto, 
  df.id_factura, 
  df.id_detalle, 
  df.anio_siniestro, 
  f.nro_factura, 
  f.nro_control, 
  f.monto_total, 
  f.fecha_factura, 
  f.fecha_recepcion, 
  f.is_factura, 
  tipo_gasto.descripcion
FROM 
  public.detalles_factura df, 
  public.siniestro s, 
  public.facturas f, 
  public.tipo_gasto
WHERE 
  s.id_siniestro = f.id_siniestro AND
  f.id_factura = df.id_factura AND
  tipo_gasto.id_tipo_gasto = df.id_tipo_gasto AND
s.anio_siniestro = 2001]]></queryString>

