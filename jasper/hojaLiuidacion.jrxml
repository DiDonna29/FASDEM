					<box></box>
					<textElement textAlignment="Center">
						<font pdfFontName="Helvetica-Bold" size="12" isBold="true"/>
					</textElement>
				<text><![CDATA[Atentamente,]]></text>
				</staticText>
				<staticText>
					<reportElement
						x="0"
						y="327"
						width="528"
						height="20"
						key="staticText"/>
					<box></box>
					<textElement textAlignment="Center">
						<font size="12"/>
					</textElement>
				<text><![CDATA[Por la Dirección Ejecutiva de la Magistratura.]]></text>
				</staticText>
				<textField isStretchWithOverflow="false" isBlankWhenNull="false" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="14"
						y="79"
						width="493"
						height="88"
						key="textField-1"/>
					<box>					<pen lineWidth="0.0" lineStyle="Dashed"/>
					<topPen lineWidth="0.0" lineStyle="Dashed"/>
					<leftPen lineWidth="0.0" lineStyle="Dashed"/>
					<bottomPen lineWidth="0.0" lineStyle="Dashed"/>
					<rightPen lineWidth="0.0" lineStyle="Dashed"/>
</box>
					<textElement textAlignment="Justified">
						<font size="12"/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA["    Por medio de la presente cumplo en informarles que el señor(a) "+$F{nombre}+", Cédula de Identidad Número: "+$F{cedula_beneficiario}+", es nuestro asegurado con el FONDO AUTOADMINISTRADO DE SALUD DE LA DIRECCIÓN EJECUTIVA DE LA MAGISTRATURA, Siniestro Número: "+$F{numero}+"."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" pattern="#,##0.00" isBlankWhenNull="false" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="14"
						y="167"
						width="493"
						height="73"
						key="textField-2"/>
					<box></box>
					<textElement textAlignment="Justified">
						<font size="12"/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA["    En virtud de antes expuesto LA DIRECCIÓN EJECUTIVA DE LA MAGISTRATURA., se hace responsable hasta por el monto máximo de BOLIVARES "+$F{monto_amparado}+ " como monto único total y definitivo por "+$F{descripcion}+ " realizado a "+$F{nombre} +" ("+$F{parentesco}+") por presentar: "+$F{tratamiento}+"."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="false" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="14"
						y="0"
						width="493"
						height="19"
						key="textField-3"/>
					<box></box>
					<textElement>
						<font pdfFontName="Helvetica" size="12" isBold="false"/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA["Señores: "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="false" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="14"
						y="38"
