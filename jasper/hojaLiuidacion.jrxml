	<field name="proveedor" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="cedula_beneficiario" class="java.lang.String"/>
	<field name="numero" class="java.lang.String"/>
	<field name="fecha_liquidacion" class="java.sql.Date"/>
	<field name="rif" class="java.lang.String"/>
	<field name="monto_amparado" class="java.lang.Double"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="parentesco" class="java.lang.String"/>
	<field name="nro_factura" class="java.lang.String"/>
	<field name="fecha_factura" class="java.sql.Date"/>

		<background>
