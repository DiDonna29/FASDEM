						width="493"
						height="38"
						key="textField-8"/>
					<box></box>
					<textElement textAlignment="Justified">
						<font size="12"/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA["    Segun Pre-factura número "+$F{nro_factura}+" de fecha "+new SimpleDateFormat("dd/MM/yyyy").format(new java.sql.Date($F{fecha_factura}.getTime()))+"."]]></textFieldExpression>
				</textField>
