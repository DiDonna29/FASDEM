	<parameter name="RUTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="id" isForPrompting="true" class="java.lang.String"/>
	<parameter name="anio" isForPrompting="true" class="java.lang.String"/>
	<parameter name="descripcion_usuario" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[SELECT * FROM view_nota_cobertura where anio_siniestro  = cast($P{anio} as numeric)
 and id_siniestro  = cast($P{id} as numeric);]]></queryString>

	<field name="tratamiento" class="java.lang.String"/>
	<field name="anio_siniestro" class="java.math.BigDecimal"/>
	<field name="id_siniestro" class="java.lang.Integer"/>
