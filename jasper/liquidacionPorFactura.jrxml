	<variable name="total_factura" class="java.lang.Double" resetType="Report" incrementType="Group" incrementGroup="id_detalle" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_amparado}]]></variableExpression>
	</variable>
	<variable name="edad_bene" class="java.lang.Integer" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new Integer($F{fecha_notificacion}.getYear() - $F{fecha_nacimiento_beneficiario}.getYear())]]></variableExpression>
	</variable>
	<variable name="total_nodeducible" class="java.lang.Double" resetType="Group" resetGroup="id_factura" calculation="Sum">
		<variableExpression><![CDATA[( $F{deducible}!=new Boolean(true) ? $F{monto_amparado} : new Double(0.0) )]]></variableExpression>
	</variable>
	<variable name="total_deducible" class="java.lang.Double" resetType="Group" resetGroup="id_detalle" calculation="Sum">
		<variableExpression><![CDATA[( $F{deducible}==new Boolean(true) ? $F{monto_amparado} : new Double(0.0) )]]></variableExpression>
	</variable>
