<?xml version="1.0" encoding="UTF-8"  ?>
<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="liquidacionPorFactura"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="anio" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="idSiniestro" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="descripcion_usuario" isForPrompting="false" class="java.lang.String"/>
	<parameter name="RUTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="idFactura" isForPrompting="true" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT distinct df.id_detalle, s.id_siniestro, f.id_factura,tg.id_tipo_gasto,
  (select mot_est.descripcion from motivo_estatus mot_est where mot_est.id_siniestro=cast ($P{idSiniestro} as numeric) and mot_est.fecha_fin is null and mot_est.id_estatus_siniestro=4 limit 1) as observacion,
  s.aniomes_codigo,
  s.codigo_siniestro, 
  s.subcodigo_siniestro, 
  s.fecha_ocurrencia, 
  s.fecha_notificacion, 
  s.fecha_liquidacion,
  p.descripcion || ' - '||t.descripcion as tratamiento, 
  tt.descripcion as tipo_tramite, 
  tipo_siniestro.descripcion as tipo_siniestro, 
  te.descripcion as tipo_empleado, 
  s.cedula_beneficiario, 
  s.cedula, 
  s.nombres || ' ' ||s.apellidos as titular, 
  s.nombres_beneficiario || ' ' || s.apellidos_beneficiario as beneficiario, 
  s.parentesco, 
  s.fecha_ingreso, 
  s.sexo_beneficiario, 
  s.fecha_nacimiento_beneficiario,
  CASE WHEN tg.id_tipo_gasto<>35 THEN df.monto_amparado
            ELSE 0
       END as monto_amparado,
       CASE WHEN tg.id_tipo_gasto=35 THEN df.monto_amparado
            ELSE 0
       END as monto_no_amparado,
       df.monto_amparado as monto_facturado,
  f.nro_factura, 
  f.nro_control, 
  f.monto_total, 
  f.fecha_factura, 
  f.fecha_recepcion, 
  f.is_factura,
  df.id_factura, 
  df.anio_siniestro, 
  df.monto_amparado, 
  tg.descripcion,
  tg.deducible,
  prov.descripcion as proveedor
FROM 
  public.siniestro s 
  inner join patologia_organo_tratamiento pot
  on pot.id_pat_org_trat_esp = s.id_patologia_organo_tratamiento  
  inner join  patologias p
  on p.id_patologia=pot.id_patologia
  inner join  tratamiento t
  on t.id_tratamiento = pot.id_tratamiento
  inner join  tipo_tramite tt
  on tt.id_tipo_tramite = s.id_tipo_tramite  
  inner join  tipo_siniestro
  on tipo_siniestro.id_tipo_siniestro = s.id_tipo_siniestro
  inner join  tipo_empleado te
  on s.id_tipo_empleado = te.id_tipo_empleado 
  inner join  facturas f
  on f.id_siniestro = s.id_siniestro and f.id_factura = $P{idFactura}  
  inner join  detalles_factura df
  on f.id_factura = df.id_factura  
  inner join  tipo_gasto tg
  on tg.id_tipo_gasto = df.id_tipo_gasto
  inner join  proveedor prov
  on s.id_proveedor = prov.id_proveedor
  WHERE 
    s.anio_siniestro =cast ($P{anio} as numeric) AND
    df.anio_siniestro =s.anio_siniestro AND
    f.anio_siniestro =s.anio_siniestro AND
  s.id_siniestro = cast ($P{idSiniestro} as numeric)
  order by df.id_detalle, s.id_siniestro,f.id_factura,tg.id_tipo_gasto]]></queryString>

