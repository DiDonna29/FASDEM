	<parameter name="idFactura" isForPrompting="true" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(479)]]></defaultValueExpression>
	</parameter>
	<parameter name="total_facturado" isForPrompting="false" class="java.lang.Double"/>
	<queryString><![CDATA[SELECT 
  df.id_detalle, 
  tg.descripcion, 
  df.monto_amparado, 
  df.monto_no_amparado, 
  df.monto_negociado, 
  df.monto_presupuestado
FROM 
  public.detalles_factura df, 
  public.tipo_gasto tg
WHERE 
  df.id_tipo_gasto = tg.id_tipo_gasto AND
  monto_no_amparado is not null AND
  monto_no_amparado != 0 AND
  df.id_factura = $P{idFactura}]]></queryString>

	<field name="id_detalle" class="java.lang.Integer"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="monto_amparado" class="java.lang.Double"/>
	<field name="monto_no_amparado" class="java.lang.Double"/>
	<field name="monto_negociado" class="java.lang.Double"/>
	<field name="monto_presupuestado" class="java.lang.Double"/>

	<variable name="total_noampara" class="java.lang.Double" resetType="Group" resetGroup="total_noamparado" calculation="Sum">
